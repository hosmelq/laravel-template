@@ -0,0 +1,79 @@
+import {defineRailway, github, preserve, project, service} from 'railway/iac'
+
+export default defineRailway(() => {
+  const app = service('app', {
+    build: {
+      builder: 'DOCKERFILE',
+      dockerfilePath: 'infrastructure/railway/app.Dockerfile',
+    },
+    deploy: {
+      drainingSeconds: 15,
+      limitOverride: {
+        containers: {
+          cpu: 0.2,
+          memoryBytes: 536870912,
+        },
+      },
+      numReplicas: 1,
+      restartPolicyType: 'ALWAYS',
+    },
+    env: {
+      APP_ENV: preserve(),
+      LARAVEL_ENV_ENCRYPTION_KEY: preserve(),
+      PORT: '8080',
+    },
+    healthcheck: '/up',
+    source: github('template/template', {branch: 'main', checkSuites: true}),
+  })
+
+  const queue = service('queue', {
+    build: {
+      builder: 'DOCKERFILE',
+      dockerfilePath: 'infrastructure/railway/worker.Dockerfile',
+    },
+    deploy: {
+      drainingSeconds: 210,
+      limitOverride: {
+        containers: {
+          cpu: 0.2,
+          memoryBytes: 536870912,
+        },
+      },
+      numReplicas: 1,
+      restartPolicyType: 'ALWAYS',
+    },
+    env: {
+      APP_ENV: preserve(),
+      LARAVEL_ENV_ENCRYPTION_KEY: preserve(),
+    },
+    source: github('template/template', {branch: 'main', checkSuites: true}),
+    start:
+      'docker-php-serversideup-entrypoint php /var/www/html/artisan queue:work database --timeout=180 --tries=3',
+  })
+
+  const scheduler = service('scheduler', {
+    build: {
+      builder: 'DOCKERFILE',
+      dockerfilePath: 'infrastructure/railway/worker.Dockerfile',
+    },
+    deploy: {
+      drainingSeconds: 60,
+      limitOverride: {
+        containers: {
+          cpu: 0.2,
+          memoryBytes: 536870912,
+        },
+      },
+      numReplicas: 1,
+      restartPolicyType: 'ALWAYS',
+    },
+    env: {
+      APP_ENV: preserve(),
+      LARAVEL_ENV_ENCRYPTION_KEY: preserve(),
+    },
+    source: github('template/template', {branch: 'main', checkSuites: true}),
+    start: 'docker-php-serversideup-entrypoint php /var/www/html/artisan schedule:work --whisper',
+  })
+
+  return project('Template', {resources: [app, queue, scheduler]})
+})
