+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertAuthenticatedAs;
+use function Pest\Laravel\assertDatabaseCount;
+use function Pest\Laravel\assertDatabaseHas;
+use function Pest\Laravel\assertDatabaseMissing;
+use function Pest\Laravel\assertGuest;
+use function Pest\Laravel\post;
+use function Pest\Laravel\postJson;
+use function Pest\Laravel\withSession;
+
+use App\Enums\AuditLogEvent;
+use App\Enums\MembershipRole;
+use App\Models\Invitation;
+use App\Models\User;
+use HosmelQ\AuditLog\Data\AuditLogData;
+use HosmelQ\AuditLog\Facades\AuditLog;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Validator;
+
+it('rejects unknown invitations before creating an account', function (): void {
+    postJson(route('invitations.register', 'missing'))->assertNotFound();
+
+    assertDatabaseCount('users', 0);
+    assertGuest();
+});
+
+it('rejects expired and accepted invitations before creating an account', function (
+    string $state,
+): void {
+    $invitation = Invitation::factory()->withToken('invitation-token')->{$state}()->createOne();
+
+    postJson(route('invitations.register', 'invitation-token'))->assertNotFound();
+
+    assertDatabaseCount('users', 1);
+    assertDatabaseCount('organization_user', 0);
+    assertDatabaseMissing('users', ['email' => $invitation->email]);
+    assertGuest();
+})->with(['accepted', 'expired']);
+
+it('rejects an invitation email that already has an account with 409', function (): void {
+    $user = User::factory()->createOne();
+    $invitation = Invitation::factory()
+        ->withToken('invitation-token')
+        ->createOne(['email' => $user->email]);
+
+    postJson(route('invitations.register', 'invitation-token'))->assertConflict();
+
+    assertDatabaseCount('users', 2);
+    assertDatabaseCount('organization_user', 0);
+    expect($invitation->fresh()->accepted_at)->toBeNull();
+    assertGuest();
+});
+
+it('rejects signed-in users without accepting or creating another account', function (): void {
+    login();
+    $invitation = Invitation::factory()->withToken('invitation-token')->createOne();
+
+    post(route('invitations.register', 'invitation-token'))->assertRedirectToRoute(
+        'organizations.create',
+    );
+
+    assertDatabaseCount('users', 2);
+    assertDatabaseCount('organization_user', 0);
+    expect($invitation->fresh()->accepted_at)->toBeNull();
+});
+
+it('uses the authentication feature validation without accepting the invitation', function (): void {
+    Validator::fakeDnsLookups();
+    $invitation = Invitation::factory()->withToken('invitation-token')->createOne();
+
+    postJson(route('invitations.register', 'invitation-token'), [
+        'password' => 'new-password',
+        'password_confirmation' => 'different-password',
+    ])->assertUnprocessable()->assertJsonValidationErrors([
+        'first_name' => 'The first name field is required.',
+        'last_name' => 'The last name field is required.',
+        'password' => 'The password field confirmation does not match.',
+    ]);
+
+    assertDatabaseMissing('users', ['email' => $invitation->email]);
+    assertDatabaseCount('organization_user', 0);
+    expect($invitation->fresh()->accepted_at)->toBeNull();
+    assertGuest();
+});
+
+it('registers with the invitation email and joins with its role', function (
+    MembershipRole $role,
+    string $destination,
+): void {
+    AuditLog::fake();
+    Validator::fakeDnsLookups();
+    $invitation = Invitation::factory()
+        ->withToken('invitation-token')
+        ->createOne(['role' => $role]);
+    withSession(['url.intended' => '/unrelated', '_token' => 'old-token']);
+    $sessionId = session()->getId();
+
+    post(route('invitations.register', 'invitation-token'), [
+        'email' => 'different@example.com',
+        'email_verified_at' => null,
+        'first_name' => 'Alex',
+        'last_name' => 'Smith',
+        'password' => 'new-password',
+        'password_confirmation' => 'new-password',
+        'role' => MembershipRole::Owner->value,
+    ])->assertRedirect(
+        $destination === 'home' ? route('home') : route($destination, $invitation->organization),
+    )
+        ->assertSessionMissing('url.intended');
+
+    $user = User::query()->where('email', $invitation->email)->sole();
+    assertAuthenticatedAs($user);
+    assertDatabaseHas('organization_user', [
+        'organization_id' => $invitation->organization_id,
+        'user_id' => $user->id,
+    ]);
+    assertDatabaseMissing('users', ['email' => 'different@example.com']);
+    expect($user)->current_organization_id->toBe($invitation->organization_id)
+        ->first_name->toBe('Alex')->last_name->toBe('Smith')->hasVerifiedEmail()->toBeTrue()
+        ->and(Hash::check('new-password', $user->password))->toBeTrue()
+        ->and($invitation->fresh()->accepted_at)->toEqual(now())
+        ->and(session()->getId())->not->toBe($sessionId);
+    setPermissionsTeamId($invitation->organization_id);
+    expect($user->hasRole($role))->toBeTrue();
+    AuditLog::assertRecorded(
+        fn (AuditLogData $log): bool => $log->event === AuditLogEvent::UserCreated->value
+            && $log->actor->id === (string) $user->id,
+    );
+    AuditLog::assertRecorded(
+        fn (AuditLogData $log): bool => $log->event === AuditLogEvent::InvitationAccepted->value
+            && $log->actor->id === (string) $user->id
+            && $log->tenantId === (string) $invitation->organization_id,
+    );
+})->with([
+    'admin' => [MembershipRole::Admin, 'organizations.settings.general'],
+    'viewer' => [MembershipRole::Viewer, 'home'],
+]);
diff --git a/tests/Feature/Http/Controllers/InvitationSessionControllerTest.php b/tests/Feature/Http/Controllers/InvitationSessionControllerTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Feature/Http/Controllers/InvitationSessionControllerTest.php
@@ -0,0 +1,39 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertGuest;
+use function Pest\Laravel\delete;
+use function Pest\Laravel\deleteJson;
+use function Pest\Laravel\get;
+use function Pest\Laravel\withSession;
+
+use App\Models\Invitation;
+
+it('requires authentication before signing out of an invitation session', function (): void {
+    deleteJson(route('invitations.session.destroy', 'invitation-token'))->assertUnauthorized();
+});
+
+it('signs out another account and returns to the same invitation', function (): void {
+    login();
+    $invitation = Invitation::factory()->withToken('invitation-token')->createOne();
+    withSession([
+        '_token' => 'old-token',
+        'private-data' => 'old-session',
+        'url.intended' => '/unrelated',
+    ]);
+    $sessionId = session()->getId();
+
+    delete(route('invitations.session.destroy', 'invitation-token'))
+        ->assertRedirectToRoute('invitations.show', 'invitation-token')
+        ->assertSessionMissing('private-data')
+        ->assertSessionMissing('url.intended');
+
+    assertGuest();
+    expect(session()->getId())->not->toBe($sessionId)
+        ->and(session()->token())->not->toBe('old-token')
+        ->and($invitation->fresh()->accepted_at)->toBeNull();
+
+    get(route('invitations.show', 'invitation-token'))->assertOk()
+        ->assertSessionHas('url.intended', route('invitations.show', 'invitation-token'));
+});
diff --git a/tests/Feature/Http/Responses/LoginResponseTest.php b/tests/Feature/Http/Responses/LoginResponseTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Feature/Http/Responses/LoginResponseTest.php
@@ -0,0 +1,121 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertAuthenticatedAs;
+use function Pest\Laravel\get;
+use function Pest\Laravel\post;
+use function Pest\Laravel\postJson;
+use function Pest\Laravel\withSession;
+
+use App\Enums\MembershipRole;
+use App\Models\Invitation;
+use App\Models\Organization;
+use App\Models\User;
+use Inertia\Testing\AssertableInertia;
+
+it('redirects a browser login without an organization to onboarding', function (): void {
+    $user = User::factory()->createOne();
+
+    post(route('login.store'), ['email' => $user->email, 'password' => 'password'])
+        ->assertRedirectToRoute('organizations.create');
+
+    assertAuthenticatedAs($user);
+});
+
+it('redirects a browser login into the current organization instead of an older membership', function (): void {
+    $user = User::factory()->createOne();
+    $organizations = Organization::factory()->count(2)->create();
+    $organization = $organizations->last();
+    $user->organizations()->attach($organizations);
+    $user->switchOrganization($organization);
+    $user->assignRole(MembershipRole::Admin);
+
+    post(route('login.store'), ['email' => $user->email, 'password' => 'password'])
+        ->assertRedirectToRoute('organizations.settings.general', $organization);
+
+    assertAuthenticatedAs($user);
+    expect($user->fresh()->current_organization_id)->toBe($organization->id);
+});
+
+it('switches to the oldest membership when the current organization is missing', function (): void {
+    $user = User::factory()->createOne();
+    $organizations = Organization::factory()->count(2)->create();
+    $firstOrganization = $organizations->first();
+    $user->organizations()->attach($organizations);
+    setPermissionsTeamId($firstOrganization->id);
+    $user->assignRole(MembershipRole::Admin);
+
+    post(route('login.store'), ['email' => $user->email, 'password' => 'password'])
+        ->assertRedirectToRoute('organizations.settings.general', $firstOrganization);
+
+    expect($user->fresh()->current_organization_id)->toBe($firstOrganization->id);
+});
+
+it('keeps viewers out of settings while selecting their organization', function (): void {
+    $organization = Organization::factory()->createOne();
+    $user = User::factory()->createOne();
+    $user->organizations()->attach($organization);
+
+    post(route('login.store'), ['email' => $user->email, 'password' => 'password'])
+        ->assertRedirectToRoute('home');
+
+    expect($user->fresh()->current_organization_id)->toBe($organization->id);
+});
+
+it('honors an intended invitation URL after login', function (): void {
+    $user = User::factory()->createOne();
+    Invitation::factory()->withToken('invitation-token')->createOne(['email' => $user->email]);
+    get(route('invitations.show', 'invitation-token'))->assertOk();
+
+    post(route('login.store'), ['email' => $user->email, 'password' => 'password'])
+        ->assertRedirectToRoute('invitations.show', 'invitation-token')
+        ->assertSessionMissing('url.intended');
+});
+
+it('preserves the JSON login contract and intended URL', function (): void {
+    $user = User::factory()->createOne();
+    withSession(['url.intended' => route('organizations.create')]);
+
+    postJson(route('login.store'), ['email' => $user->email, 'password' => 'password'])
+        ->assertOk()->assertExactJson(['two_factor' => false])
+        ->assertSessionHas('url.intended', route('organizations.create'));
+
+    assertAuthenticatedAs($user);
+});
+
+it('redirects signed-in guests-only page visits to onboarding', function (string $path): void {
+    login();
+
+    get($path)->assertRedirectToRoute('organizations.create');
+})->with(['/login', '/register']);
+
+it('redirects signed-in guests-only page visits into the organization', function (): void {
+    $organization = Organization::factory()->createOne();
+    $user = login(organization: $organization);
+    $user->switchOrganization($organization);
+    $user->assignRole(MembershipRole::Admin);
+
+    get('/login')->assertRedirectToRoute('organizations.settings.general', $organization);
+});
+
+it('continues email confirmation into organization onboarding', function (): void {
+    login();
+
+    get(route('verification.verified'))->assertOk()->assertInertia(
+        fn (AssertableInertia $page): AssertableInertia => $page
+            ->where('continueUrl', route('organizations.create')),
+    );
+});
+
+it('continues email confirmation into an existing organization', function (): void {
+    $organization = Organization::factory()->createOne();
+    $user = login(organization: $organization);
+    $user->switchOrganization($organization);
+    $user->assignRole(MembershipRole::Admin);
+
+    get(route('verification.verified'))->assertOk()->assertInertia(
+        fn (AssertableInertia $page): AssertableInertia => $page
+            ->where('continueUrl', route('organizations.settings.general', $organization)),
+    );
+});
