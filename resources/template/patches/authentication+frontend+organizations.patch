+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertAuthenticatedAs;
+use function Pest\Laravel\assertDatabaseHas;
+use function Pest\Laravel\assertGuest;
+
+use App\Enums\MembershipRole;
+use App\Models\Invitation;
+use App\Models\User;
+use Illuminate\Support\Facades\Validator;
+
+it('creates an account from an invitation and accepts it as a new user', function (): void {
+    Validator::fakeDnsLookups();
+    $invitation = Invitation::factory()->withToken('invitation-token')->createOne();
+
+    visit('/invitations/invitation-token')
+        ->assertSee('Join '.$invitation->organization->name)
+        ->assertValue('Email', $invitation->email)
+        ->assertAttribute('email', 'readonly', '')
+        ->type('First name', 'Alex')->type('Last name', 'Smith')
+        ->type('Password', 'new-password')->type('Confirm password', 'new-password')
+        ->press('Accept and join')->assertPathIs('/')
+        ->assertNoJavascriptErrors();
+
+    $user = User::query()->where('email', $invitation->email)->sole();
+    assertAuthenticatedAs($user);
+    assertDatabaseHas('organization_user', [
+        'organization_id' => $invitation->organization_id,
+        'user_id' => $user->id,
+    ]);
+    expect($invitation->fresh()->accepted_at)->not->toBeNull()
+        ->and($user)->current_organization_id->toBe($invitation->organization_id)
+        ->hasVerifiedEmail()
+        ->toBeTrue();
+});
+
+it('signs an existing account in and accepts its invitation', function (): void {
+    $user = User::factory()->createOne();
+    $invitation = Invitation::factory()->withToken('invitation-token')->createOne([
+        'email' => $user->email,
+        'role' => MembershipRole::Admin,
+    ]);
+
+    visit('/invitations/invitation-token')->assertDontSee('Accept and join')
+        ->click('Sign in')->type('Email', $user->email)->type('Password', 'password')
+        ->press('button[type="submit"]')->assertPathIs('/invitations/invitation-token')
+        ->press('Accept invitation')
+        ->assertPathIs('/organizations/'.$invitation->organization->slug.'/settings/general')
+        ->assertNoJavascriptErrors();
+
+    assertAuthenticatedAs($user);
+    expect($invitation->fresh()->accepted_at)->not->toBeNull();
+});
+
+it('signs out another account and returns to the invitation registration form', function (): void {
+    login();
+    Invitation::factory()->withToken('invitation-token')->createOne();
+
+    visit('/invitations/invitation-token')->assertDontSee('Accept and join')
+        ->press('Use another account')->assertPathIs('/invitations/invitation-token')
+        ->assertSee('Accept and join')->assertSee('Already have an account?')
+        ->assertNoJavascriptErrors();
+
+    assertGuest();
+});
