+            preload: [{weight: 400}, {weight: 600}],
+            styles: ['normal'],
+            subsets: ['latin'],
+            weights: [100, 200, 300, 400, 500, 600, 700, 800, 900],
+          }),
+        ],
+        input: ['resources/js/app.tsx'],
+        refresh: true,
+      }),
+      manifestSRI(),
