+++ b/resources/js/app.tsx
@@ -0,0 +1,55 @@
+import './index.css'
+import './telemetry'
+import {config} from '@fortawesome/fontawesome-svg-core'
+import {RouterProvider, toast as heroToast, Toast} from '@heroui/react'
+import {createInertiaApp, router, type ResolvedComponent} from '@inertiajs/react'
+import {ModalStackProvider} from '@inertiaui/modal-react'
+import {I18nProvider} from 'react-aria-components'
+
+import {layoutFor} from '#/layouts'
+
+config.autoAddCss = false
+
+router.on('flash', (event) => {
+  const {toast} = event.detail.flash
+
+  if (!toast) {
+    return
+  }
+
+  heroToast(toast.title, {
+    description: toast.description,
+    timeout: toast.timeout,
+    variant: toast.variant,
+  })
+})
+
+void createInertiaApp({
+  layout: (name) => layoutFor(name),
+  progress: {
+    color: 'var(--accent)',
+  },
+  title: (title) => (title.length > 0 ? `${title} - Template` : 'Template'),
+  resolve: (name) => {
+    const pages = import.meta.glob<ResolvedComponent>([
+      './pages/**/*.tsx',
+      '!./pages/**/_components/**/*.tsx',
+    ])
+    const page = pages[`./pages/${name}.tsx`]
+
+    if (typeof page === 'undefined') {
+      throw new Error(`Page not found: ${name}.`)
+    }
+
+    return page()
+  },
+  strictMode: true,
+  withApp: (app, {page}) => (
+    <I18nProvider locale={page.props.locale}>
+      <RouterProvider navigate={(path, routerOptions) => router.visit(path, routerOptions)}>
+        <ModalStackProvider>{app}</ModalStackProvider>
+        <Toast.Provider />
+      </RouterProvider>
+    </I18nProvider>
+  ),
+})
diff --git a/resources/js/components/Form.tsx b/resources/js/components/Form.tsx
new file mode 100644
--- /dev/null
+++ b/resources/js/components/Form.tsx
@@ -0,0 +1,34 @@
+import type {FormComponentProps, FormComponentRef, FormComponentSlotProps} from '@inertiajs/core'
+import {Form as InertiaForm} from '@inertiajs/react'
+import {
+  type AllHTMLAttributes,
+  type FormHTMLAttributes,
+  type ReactElement,
+  type ReactNode,
+  type RefAttributes,
+} from 'react'
+import {FormContext, FormValidationContext} from 'react-aria-components'
+
+type FormProps<TForm extends object = Record<string, any>> = FormComponentProps<TForm> &
+  Omit<FormHTMLAttributes<HTMLFormElement>, keyof FormComponentProps<TForm> | 'children'> &
+  Omit<AllHTMLAttributes<HTMLFormElement>, keyof FormComponentProps<TForm> | 'children'> & {
+    children: ReactNode | ((props: FormComponentSlotProps<TForm>) => ReactNode)
+  }
+
+export function Form<TForm extends object = Record<string, any>>({
+  children,
+  ref,
+  ...otherProps
+}: FormProps<TForm> & RefAttributes<FormComponentRef<TForm>>): ReactElement {
+  return (
+    <InertiaForm<TForm> ref={ref} {...otherProps}>
+      {(slotProps: FormComponentSlotProps<TForm>) => (
+        <FormContext.Provider value={{validationBehavior: 'aria'}}>
+          <FormValidationContext.Provider value={slotProps.errors}>
+            {typeof children === 'function' ? children(slotProps) : children}
+          </FormValidationContext.Provider>
+        </FormContext.Provider>
+      )}
+    </InertiaForm>
+  )
+}
diff --git a/resources/js/components/Layout.tsx b/resources/js/components/Layout.tsx
new file mode 100644
--- /dev/null
+++ b/resources/js/components/Layout.tsx
@@ -0,0 +1,122 @@
+import {cn} from '@heroui/react'
+import type {ReactNode} from 'react'
+
+interface BodyProps {
+  children: ReactNode
+  noRowGap?: boolean
+}
+
+export function Body(props: BodyProps) {
+  return (
+    <div
+      className={cn(
+        'grow bg-background p-4 lg:grid lg:grid-cols-[minmax(100px,auto)_325px] lg:content-start',
+        props.noRowGap ? 'md:px-8 md:py-4 lg:gap-x-6' : 'md:px-8 md:py-6 lg:gap-6',
+      )}
+    >
+      {props.children}
+    </div>
+  )
+}
+
+interface HeaderProps {
+  borderStyle?: 'dashed' | 'solid'
+  children: ReactNode
+  noActionWrap?: boolean
+  unified?: boolean
+}
+
+export function Header(props: HeaderProps) {
+  return (
+    <header
+      className={cn(
+        'grid px-4 pt-4 md:grid-cols-[minmax(0,1fr)_auto] md:px-8',
+        props.noActionWrap ? 'grid-cols-[minmax(0,1fr)_auto]' : 'grid-cols-1',
+        !props.unified &&
+          `border-b border-border ${props.borderStyle === 'dashed' ? 'border-dashed' : 'border-solid'}`,
+        props.unified ? 'bg-background' : 'bg-transparent',
+      )}
+    >
+      {props.children}
+    </header>
+  )
+}
+
+interface HeaderActionsProps {
+  children: ReactNode
+}
+
+export function HeaderActions(props: HeaderActionsProps) {
+  return (
+    <div className="mt-0.5 mb-4 flex w-max min-w-max flex-col justify-normal md:mb-0 md:w-auto">
+      {props.children}
+    </div>
+  )
+}
+
+interface HeaderContentProps {
+  children: ReactNode
+  unified?: boolean
+}
+
+export function HeaderContent(props: HeaderContentProps) {
+  return (
+    <div className={cn('flex w-full flex-col justify-normal', !props.unified && 'mb-2')}>
+      {props.children}
+    </div>
+  )
+}
+
+interface MainProps {
+  children: ReactNode
+  width?: 'full-constrained' | 'two-thirds'
+}
+
+export function Main(props: MainProps) {
+  const {children, width = 'two-thirds'} = props
+
+  return (
+    <section className={cn('w-full', width === 'two-thirds' ? 'col-[1/2]' : 'col-[1/3]')}>
+      {width === 'full-constrained' ? <div className="max-w-7xl">{children}</div> : children}
+    </section>
+  )
+}
+
+interface PageProps {
+  children: ReactNode
+  withPadding?: boolean
+}
+
+export function Page(props: PageProps) {
+  return (
+    <main className={cn('flex flex-1 flex-col', props.withPadding && 'px-8 py-6')}>
+      {props.children}
+    </main>
+  )
+}
+
+interface TitleProps {
+  children: ReactNode
+  withMargins?: boolean
+}
+
+export function Title(props: TitleProps) {
+  return (
+    <h1
+      className={cn(
+        'flex items-center gap-2 truncate text-2xl leading-10 font-semibold',
+        props.withMargins && 'mt-2 mb-6',
+      )}
+    >
+      {props.children}
+    </h1>
+  )
+}
+
+interface SideProps {
+  children: ReactNode
+}
