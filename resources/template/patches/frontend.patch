+
+use Illuminate\Support\Facades\App;
+use Illuminate\Support\Facades\Route;
+
+beforeEach(function (): void {
+    Route::middleware('web')->get('/_test', fn (): string => App::currentLocale());
+});
+
+it('negotiates the supported browser language', function (string $header, string $expected): void {
+    withHeaders(['Accept-Language' => $header]);
+
+    get('/_test')->assertOk()->assertContent($expected)->assertCookie('locale', $expected);
+})->with([
+    'English' => ['en-US,en;q=0.9', 'en'],
+    'Spanish' => ['es-NI,es;q=0.9,en;q=0.5', 'es'],
+    'unsupported' => ['fr-FR,fr;q=0.9', 'en'],
+]);
+
+it('prefers a supported locale cookie over the browser language', function (): void {
+    withCookie('locale', 'es');
+    withHeaders(['Accept-Language' => 'en-US']);
+
+    get('/_test')->assertOk()->assertContent('es');
+});
+
+it('replaces an unsupported locale cookie', function (): void {
+    withCookie('locale', 'fr');
+    withHeaders(['Accept-Language' => 'es-419']);
+
+    get('/_test')->assertOk()->assertContent('es')->assertCookie('locale', 'es');
+});
