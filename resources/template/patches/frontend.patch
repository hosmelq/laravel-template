diff --git a/resources/js/components/UnsavedChangesBar.tsx b/resources/js/components/UnsavedChangesBar.tsx
new file mode 100644
--- /dev/null
+++ b/resources/js/components/UnsavedChangesBar.tsx
@@ -0,0 +1,106 @@
+import {faCircle} from '@fortawesome/pro-solid-svg-icons'
+import {FontAwesomeIcon} from '@fortawesome/react-fontawesome'
+import {ActionBar} from '@heroui-pro/react'
+import {AlertDialog, Button, Chip, Separator} from '@heroui/react'
+import type {PendingVisit, VisitCallbacks} from '@inertiajs/core'
+import {router} from '@inertiajs/react'
+import {useEffect, useRef, useState} from 'react'
+
+interface UnsavedChangesBarProps {
+  isDirty: boolean
+  isPending: boolean
+  onDiscard: () => void
+}
+
+export function UnsavedChangesBar(props: UnsavedChangesBarProps) {
+  const {isDirty, isPending, onDiscard} = props
+  const [blockedVisit, setBlockedVisit] = useState<null | (PendingVisit & Partial<VisitCallbacks>)>(
+    null,
+  )
+  const isLeavingRef = useRef(false)
+
+  useEffect(() => {
+    if (!isDirty) {
+      return
+    }
+
+    return router.on('before', (event) => {
+      const visit = event.detail.visit
+
+      if (
+        isLeavingRef.current ||
+        visit.method !== 'get' ||
+        visit.prefetch ||
+        visit.url.href === window.location.href ||
+        (visit.url.pathname === window.location.pathname &&
+          (visit.only.length > 0 || visit.except.length > 0))
+      ) {
+        return
+      }
+
+      event.preventDefault()
+      setBlockedVisit(visit)
+    })
+  }, [isDirty])
+
+  const leave = () => {
+    if (!blockedVisit) {
+      return
+    }
+
+    isLeavingRef.current = true
+    setBlockedVisit(null)
+    router.visit(blockedVisit.url, {
+      ...blockedVisit,
+      onFinish: (visit) => {
+        isLeavingRef.current = false
+        blockedVisit.onFinish?.(visit)
+      },
+    })
+  }
+
+  return (
+    <>
+      <ActionBar aria-label="Unsaved changes" isOpen={isDirty}>
+        <ActionBar.Prefix>
+          <Chip color="warning" size="sm">
+            <FontAwesomeIcon className="size-1.5" icon={faCircle} />
+            <Chip.Label>Unsaved changes</Chip.Label>
+          </Chip>
+        </ActionBar.Prefix>
+        <Separator orientation="vertical" />
+        <ActionBar.Content>
+          <Button isDisabled={isPending} size="sm" variant="ghost" onPress={onDiscard}>
+            Discard
+          </Button>
+          <Button isPending={isPending} size="sm" type="submit">
+            Save
+          </Button>
+        </ActionBar.Content>
+      </ActionBar>
+      <AlertDialog.Backdrop
+        isOpen={blockedVisit !== null}
+        onOpenChange={(isOpen) => !isOpen && setBlockedVisit(null)}
+      >
+        <AlertDialog.Container>
+          <AlertDialog.Dialog>
+            <AlertDialog.Header>
+              <AlertDialog.Heading>Discard changes?</AlertDialog.Heading>
+            </AlertDialog.Header>
+            <AlertDialog.Body>
+              If you leave now, your unsaved changes will be lost.
+            </AlertDialog.Body>
+            <AlertDialog.Footer>
+              <Button slot="close" variant="tertiary">
+                Keep editing
+              </Button>
+              <Button variant="danger" onPress={leave}>
+                Discard
+              </Button>
+            </AlertDialog.Footer>
+          </AlertDialog.Dialog>
+        </AlertDialog.Container>
+      </AlertDialog.Backdrop>
+    </>
+  )
+}
