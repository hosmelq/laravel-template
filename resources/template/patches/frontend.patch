new file mode 100644
--- /dev/null
+++ b/app/Http/Middleware/HandleInertiaRequests.php
@@ -0,0 +1,37 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Middleware;
+
+use App\Enums\Locale;
+use Illuminate\Http\Request;
+use Illuminate\Http\Resources\Json\JsonResource;
+use Illuminate\Support\Facades\App;
+use Inertia\Middleware;
+use Override;
+
+class HandleInertiaRequests extends Middleware
+{
+    #[Override]
+    public function share(Request $request): array
+    {
+        return [
+            ...parent::share($request),
+            'auth' => $this->authProperties($request),
+            'locale' => Locale::from(App::getLocale())->languageTag(),
+        ];
+    }
+
+    /**
+     * @return array{user: null|JsonResource}
+     */
+    private function authProperties(Request $request): array
+    {
+        $user = $request->user();
+
+        return [
+            'user' => $user?->toResource(),
+        ];
+    }
+}
diff --git a/app/Http/Middleware/SetLocale.php b/app/Http/Middleware/SetLocale.php
new file mode 100644
--- /dev/null
+++ b/app/Http/Middleware/SetLocale.php
@@ -0,0 +1,34 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Middleware;
+
+use App\Enums\Locale;
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\App;
+use Illuminate\Support\Facades\Cookie;
+use Symfony\Component\HttpFoundation\Response;
+
+class SetLocale
+{
+    /**
+     * @param Closure(Request): Response $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $cookieLocale = $request->cookie('locale');
+        $locale = is_string($cookieLocale) ? Locale::tryFrom($cookieLocale) : null;
+
+        if ($locale === null) {
+            $locale = Locale::from($request->getPreferredLanguage(Locale::values()) ?? Locale::English());
+
+            Cookie::queue(Cookie::forever('locale', $locale->value));
+        }
+
+        App::setLocale($locale->value);
+
+        return $next($request);
+    }
+}
