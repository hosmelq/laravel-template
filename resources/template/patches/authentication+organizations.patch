diff --git a/tests/Feature/Listeners/OrganizationAuthenticationAuditLogTest.php b/tests/Feature/Listeners/OrganizationAuthenticationAuditLogTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Feature/Listeners/OrganizationAuthenticationAuditLogTest.php
@@ -0,0 +1,34 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Enums\AuditLogEvent;
+use App\Models\Organization;
+use App\Models\User;
+use HosmelQ\AuditLog\Data\AuditLogData;
+use HosmelQ\AuditLog\Facades\AuditLog;
+use Illuminate\Auth\Events\Login;
+use Illuminate\Auth\Events\Verified;
+use Illuminate\Support\Facades\Event;
+
+it('records the current organization as the tenant of authentication events', function (
+    string $event,
+    AuditLogEvent $auditLogEvent,
+): void {
+    AuditLog::fake();
+    $organization = Organization::factory()->createOne();
+    $user = User::factory()->withOrganization($organization)->createOne();
+
+    $user->switchOrganization($organization);
+
+    Event::dispatch(match ($event) {
+        'login' => new Login('web', $user, false),
+        'verified' => new Verified($user),
+    });
+
+    AuditLog::assertRecorded(fn (AuditLogData $log): bool => $log->event === $auditLogEvent->value
+        && $log->tenantId === (string) $organization->id);
+})->with([
+    'login' => ['login', AuditLogEvent::AuthLogin],
+    'verified' => ['verified', AuditLogEvent::AuthEmailVerified],
+]);
