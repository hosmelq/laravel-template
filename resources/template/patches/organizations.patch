new file mode 100644
--- /dev/null
+++ b/tests/Integration/Seeders/RolesAndPermissionsSeederTest.php
@@ -0,0 +1,105 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Enums\OrganizationRole;
+use App\Enums\Permission;
+use App\Models\Organization;
+use Database\Seeders\RolesAndPermissionsSeeder;
+use Illuminate\Cache\CacheManager;
+use Spatie\Permission\Models\Permission as PermissionModel;
+use Spatie\Permission\Models\Role as RoleModel;
+use Spatie\Permission\PermissionRegistrar;
+
+afterEach(function (): void {
+    setPermissionsTeamId(null);
+});
+
+it('seeds the exact global catalog and mappings', function (): void {
+    $this->seed(RolesAndPermissionsSeeder::class);
+
+    $permissions = PermissionModel::query()
+        ->orderBy('name')
+        ->get();
+    $roles = RoleModel::query()
+        ->whereNull('organization_id')
+        ->orderBy('name')
+        ->get();
+
+    expect($permissions)
+        ->toHaveCount(2)
+        ->and($permissions->pluck('guard_name')->unique()->all())
+        ->toBe(['web'])
+        ->and($permissions->pluck('name')->all())
+        ->toEqualCanonicalizing(Permission::values())
+        ->and($roles)
+        ->toHaveCount(2)
+        ->and($roles->pluck('guard_name')->unique()->all())
+        ->toBe(['web'])
+        ->and($roles->pluck('name')->all())
+        ->toBe(OrganizationRole::values());
+
+    foreach (OrganizationRole::cases() as $organizationRole) {
+        $role = $roles->firstWhere('name', $organizationRole->value);
+        $expectedPermissions = array_map(
+            static fn (Permission $permission): string => $permission->value,
+            $organizationRole->permissions(),
+        );
+
+        expect($role)
+            ->not->toBeNull()
+            ->and($role->permissions()->orderBy('name')->pluck('name')->all())
+            ->toEqualCanonicalizing($expectedPermissions);
+    }
+});
+
+it('seeds idempotently without creating tenant roles and restores the team context', function (): void {
+    $organization = Organization::factory()->createOne();
+
+    setPermissionsTeamId($organization);
+
+    $this->seed(RolesAndPermissionsSeeder::class);
+
+    $auditor = RoleModel::query()
+        ->where('guard_name', 'web')
+        ->where('name', OrganizationRole::Auditor->value)
+        ->whereNull('organization_id')
+        ->sole();
+
+    $auditor->givePermissionTo(Permission::OrganizationsUpdateSettings);
+
+    expect($auditor->hasPermissionTo(Permission::OrganizationsUpdateSettings))
+        ->toBeTrue();
+
+    $this->seed(RolesAndPermissionsSeeder::class);
+
+    $auditor->refresh();
+
+    expect(getPermissionsTeamId())
+        ->toBe($organization->id)
+        ->and(PermissionModel::query()->count())
+        ->toBe(2)
+        ->and(RoleModel::query()->whereNull('organization_id')->count())
+        ->toBe(2)
+        ->and(RoleModel::query()->where('organization_id', $organization->id)->count())
+        ->toBe(0)
+        ->and($auditor->hasPermissionTo(Permission::OrganizationsUpdateSettings))
+        ->toBeFalse();
+});
+
+it('restores the team context when permission cache clearing fails', function (): void {
+    $organization = Organization::factory()->createOne();
+    $permissionRegistrar = new class (resolve(CacheManager::class)) extends PermissionRegistrar {
+        public function forgetCachedPermissions(): bool
+        {
+            throw new RuntimeException('Expected cache failure.');
+        }
+    };
+
+    $permissionRegistrar->setPermissionsTeamId($organization);
+
+    expect(fn (): mixed => resolve(RolesAndPermissionsSeeder::class)->run($permissionRegistrar))
+        ->toThrow(RuntimeException::class, 'Expected cache failure.')
+        ->and($permissionRegistrar->getPermissionsTeamId())
+        ->toBe($organization->id);
+});
diff --git a/tests/Integration/Support/OrganizationPermissionContextTest.php b/tests/Integration/Support/OrganizationPermissionContextTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Integration/Support/OrganizationPermissionContextTest.php
@@ -0,0 +1,86 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Enums\Permission;
+use App\Models\Organization;
+use App\Support\OrganizationPermissionContext;
+
+afterEach(function (): void {
+    setPermissionsTeamId(null);
+});
+
+it('restores nested organization contexts and permission relations', function (): void {
+    $firstOrganization = Organization::factory()->createOne();
+    $previousOrganization = Organization::factory()->createOne();
+    $secondOrganization = Organization::factory()->createOne();
+    $user = loginWithPermission(Permission::OrganizationsView, $firstOrganization);
+
+    $user->organizations()->syncWithoutDetaching($secondOrganization);
+    setPermissionsTeamId($previousOrganization);
+
+    $organizationPermissionContext = resolve(OrganizationPermissionContext::class);
+
+    $result = $organizationPermissionContext->run(
+        $user,
+        $firstOrganization,
+        function () use (
+            $firstOrganization,
+            $organizationPermissionContext,
+            $secondOrganization,
+            $user,
+        ): string {
+            expect(getPermissionsTeamId())
+                ->toBe($firstOrganization->id)
+                ->and($user->canInOrganization($firstOrganization, Permission::OrganizationsView))
+                ->toBeTrue();
+
+            $organizationPermissionContext->run(
+                $user,
+                $secondOrganization,
+                function () use ($secondOrganization, $user): void {
+                    expect(getPermissionsTeamId())
+                        ->toBe($secondOrganization->id)
+                        ->and($user->canInOrganization($secondOrganization, Permission::OrganizationsView))
+                        ->toBeFalse();
+                },
+            );
+
+            expect(getPermissionsTeamId())
+                ->toBe($firstOrganization->id)
+                ->and($user->canInOrganization($firstOrganization, Permission::OrganizationsView))
+                ->toBeTrue();
+
+            return 'nested-result';
+        },
+    );
+
+    expect($result)
+        ->toBe('nested-result')
+        ->and(getPermissionsTeamId())
+        ->toBe($previousOrganization->id)
+        ->and($user->relationLoaded('permissions'))
+        ->toBeFalse()
+        ->and($user->relationLoaded('roles'))
+        ->toBeFalse();
+});
+
+it('restores the previous context and relations when the callback throws', function (): void {
+    $previousOrganization = Organization::factory()->createOne();
+    $targetOrganization = Organization::factory()->createOne();
+    $user = loginWithPermission(Permission::OrganizationsView, $previousOrganization);
+
+    setPermissionsTeamId($previousOrganization);
+    $user->load(['permissions', 'roles']);
+
+    $organizationPermissionContext = resolve(OrganizationPermissionContext::class);
+
+    expect(fn (): mixed => $organizationPermissionContext->run(
+        $user,
+        $targetOrganization,
+        static fn (): never => throw new RuntimeException('Expected test exception.'),
+    ))->toThrow(RuntimeException::class, 'Expected test exception.')
+        ->and(getPermissionsTeamId())->toBe($previousOrganization->id)
+        ->and($user->relationLoaded('permissions'))->toBeFalse()
+        ->and($user->relationLoaded('roles'))->toBeFalse();
+});
