+<?php
+
+declare(strict_types=1);
+
+namespace Database\Factories;
+
+use App\Enums\MembershipRole;
+use App\Models\Invitation;
+use App\Models\Organization;
+use Illuminate\Database\Eloquent\Factories\Factory;
+use Illuminate\Support\Str;
+
+/**
+ * @extends Factory<Invitation>
+ */
+class InvitationFactory extends Factory
+{
+    public function accepted(): static
+    {
+        return $this->state([
+            'accepted_at' => now(),
+        ]);
+    }
+
+    public function definition(): array
+    {
+        return [
+            'organization_id' => Organization::factory(),
+            'invited_by_user_id' => $this->invitedByUserIdFor(...),
+
+            'accepted_at' => null,
+            'email' => fake()
+                ->unique()
+                ->regexify('\w{8}@example\.com'),
+            'expires_at' => now()
+                ->addDays(7),
+            'role' => MembershipRole::Viewer,
+            'token' => hash('sha256', Str::random(40)),
+        ];
+    }
+
+    public function expired(): static
+    {
+        return $this->state([
+            'expires_at' => now()
+                ->subDay(),
+        ]);
+    }
+
+    public function withToken(string $token): static
+    {
+        return $this->state([
+            'token' => hash('sha256', $token),
+        ]);
+    }
+
+    /**
+     * @param array{organization_id: int} $attributes
+     */
+    private function invitedByUserIdFor(array $attributes): int
+    {
+        return Organization::query()
+            ->findOrFail($attributes['organization_id'])
+            ->owner_id;
+    }
+}
