@@ -0,0 +1,257 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertDatabaseHas;
+
+use App\Enums\MembershipPermission;
+use App\Enums\MembershipRole;
+use App\Models\Organization;
+use App\Models\User;
+use Spatie\Permission\Models\Role;
+
+it('checks is a user belongs to an organization', function (): void {
+    $organization = Organization::factory()->createOne();
+    $user = User::factory()->createOne();
+
+    expect($user->belongsToOrganization($organization))->toBeFalse();
+
+    $organization->users()->attach($user);
+
+    $user->refresh();
+
+    expect($user->belongsToOrganization($organization))->toBeTrue();
+});
+
+it('checks is a user owns an organization', function (): void {
+    $user = User::factory()->createOne();
+    $userOrganization = Organization::factory()->for($user, 'owner')->createOne();
+    $unrelatedOrganization = Organization::factory()->createOne();
+
+    expect($user)
+        ->ownsOrganization($userOrganization)->toBeTrue()
+        ->ownsOrganization($unrelatedOrganization)->toBeFalse();
+});
+
+it('returns the current organization as the default instead of the first membership', function (): void {
+    $firstOrganization = Organization::factory()
+        ->createOne();
+    $user = User::factory()
+        ->hasAttached($firstOrganization)
+        ->withOrganization()
+        ->createOne();
+    $currentOrganization = $user->currentOrganization;
+
+    $organization = $user->defaultOrganization();
+
+    expect($organization)
+        ->is($currentOrganization)
+        ->toBeTrue()
+        ->and($firstOrganization)
+        ->is($currentOrganization)
+        ->toBeFalse();
+});
+
+it('returns the first membership as the default without switching organizations', function (): void {
+    $organizations = Organization::factory()
+        ->count(2);
+    $user = User::factory()
+        ->has($organizations, 'organizations')
+        ->createOne();
+    $firstOrganization = $user->organizations->first();
+    setPermissionsTeamId(123);
+
+    $organization = $user->defaultOrganization();
+
+    expect($organization)
+        ->is($firstOrganization)
+        ->toBeTrue()
+        ->and($user->current_organization_id)
+        ->toBeNull()
+        ->and(getPermissionsTeamId())
+        ->toBe(123);
+
+    assertDatabaseHas(User::class, [
+        'current_organization_id' => null,
+        'id' => $user->id,
+    ]);
+});
+
+it('returns the oldest membership as the default when it was attached second', function (): void {
+    $newerOrganization = Organization::factory()
+        ->createOne();
+    $olderOrganization = Organization::factory()
+        ->createOne();
+    $user = User::factory()
+        ->hasAttached($newerOrganization, ['created_at' => '2025-01-02 00:00:00'])
+        ->hasAttached($olderOrganization, ['created_at' => '2025-01-01 00:00:00'])
+        ->createOne();
+
+    $organization = $user->defaultOrganization();
+
+    expect($organization)
+        ->is($olderOrganization)
+        ->toBeTrue()
+        ->and($user->current_organization_id)
+        ->toBeNull();
+});
+
+it('returns no default organization without memberships', function (): void {
+    $user = User::factory()
+        ->createOne();
+
+    $organization = $user->defaultOrganization();
+
+    expect($organization)
+        ->toBeNull();
+});
+
+it('does not switch organizations when loading currentOrganization without an active organization', function (): void {
+    $user = User::factory()
+        ->has(Organization::factory(), 'organizations')
+        ->createOne();
+    setPermissionsTeamId(123);
+
+    $organization = $user->currentOrganization;
+
+    expect($organization)
+        ->toBeNull()
+        ->and($user->current_organization_id)
+        ->toBeNull()
+        ->and(getPermissionsTeamId())
+        ->toBe(123);
+
+    assertDatabaseHas(User::class, [
+        'current_organization_id' => null,
+        'id' => $user->id,
+    ]);
+});
+
+it('cannot switch to an unrelated organization', function (): void {
+    $unrelatedOrganization = Organization::factory()->createOne();
+
+    $user = User::factory()->createOne();
+
+    expect($user)
+        ->switchOrganization($unrelatedOrganization)->toBeFalse()
+        ->currentOrganization->toBeNull();
+});
+
+it('can switch to a related organization', function (): void {
+    $organization = Organization::factory()->createOne();
+    $user = User::factory()->withOrganization($organization)->createOne();
+
+    expect($user)
+        ->switchOrganization($organization)->toBeTrue()
+        ->currentOrganization->is($organization)->toBeTrue();
+});
+
+it('changes role and direct permissions when switching the active organization', function (): void {
+    $user = User::factory()
+        ->withOrganization()
+        ->createOne();
+    $originalOrganization = $user->currentOrganization;
+    $newOrganization = Organization::factory()
+        ->recycle($user)
+        ->createOne();
+
+    $user->organizations()
+        ->attach($newOrganization);
+
+    setPermissionsTeamId($originalOrganization->id);
+
+    $originalRole = Role::findByName(MembershipRole::Viewer, 'web');
+
+    $originalRole->syncPermissions(MembershipPermission::SettingsView);
+
+    $user->assignRole($originalRole);
+    $user->givePermissionTo(MembershipPermission::TeamView);
+
+    setPermissionsTeamId($newOrganization->id);
+
+    $newRole = Role::findByName(MembershipRole::Viewer, 'web');
+
+    $newRole->syncPermissions(MembershipPermission::SettingsOrganization);
+
+    $user->assignRole($newRole);
+    $user->givePermissionTo(MembershipPermission::TeamManage);
+
+    $user->switchOrganization($originalOrganization);
+    $user->load(['permissions', 'roles']);
+
+    expect($user)
+        ->can(MembershipPermission::SettingsView)
+        ->toBeTrue()
+        ->can(MembershipPermission::TeamView)
+        ->toBeTrue()
+        ->can(MembershipPermission::SettingsOrganization)
+        ->toBeFalse()
+        ->can(MembershipPermission::TeamManage)
+        ->toBeFalse();
+
+    $switched = $user->switchOrganization($newOrganization);
+
+    expect($switched)
+        ->toBeTrue()
+        ->and(getPermissionsTeamId())
+        ->toBe($newOrganization->id)
+        ->and($user)
+        ->can(MembershipPermission::SettingsView)
+        ->toBeFalse()
+        ->can(MembershipPermission::TeamView)
+        ->toBeFalse()
+        ->can(MembershipPermission::SettingsOrganization)
+        ->toBeTrue()
+        ->can(MembershipPermission::TeamManage)
+        ->toBeTrue();
+
+    assertDatabaseHas(User::class, [
+        'current_organization_id' => $newOrganization->id,
+        'id' => $user->id,
+    ]);
+});
+
+it('keeps the active permission context when switching to an unrelated organization is rejected', function (): void {
+    $user = User::factory()
+        ->withOrganization()
+        ->createOne();
+    $organization = $user->currentOrganization;
+    $unrelatedOrganization = Organization::factory()
+        ->createOne();
+
+    setPermissionsTeamId($organization->id);
+
+    $user->givePermissionTo(MembershipPermission::SettingsView);
+    $user->load(['permissions', 'roles']);
+
+    $switched = $user->switchOrganization($unrelatedOrganization);
+
+    expect($switched)
+        ->toBeFalse()
+        ->and(getPermissionsTeamId())
+        ->toBe($organization->id)
+        ->and($user)
+        ->can(MembershipPermission::SettingsView)
+        ->toBeTrue();
+
+    assertDatabaseHas(User::class, [
+        'current_organization_id' => $organization->id,
+        'id' => $user->id,
+    ]);
+});
+
+it('recognizes only the current organization', function (): void {
+    $organization = Organization::factory()->createOne();
+    $otherOrganization = Organization::factory()->createOne();
+    $user = User::factory()->withOrganization($organization)->createOne();
+
+    expect($user->isCurrentOrganization($organization))->toBeTrue()
+        ->and($user->isCurrentOrganization($otherOrganization))->toBeFalse();
+});
+
+it('has no current organization before one is selected', function (): void {
+    $organization = Organization::factory()->createOne();
+    $user = User::factory()->createOne();
+
+    expect($user->isCurrentOrganization($organization))->toBeFalse();
+});
