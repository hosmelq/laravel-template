+<?php
+
+declare(strict_types=1);
+
+use App\Enums\MembershipPermission;
+use App\Enums\MembershipRole;
+use App\Models\Organization;
+use App\Models\User;
+use App\Policies\OrganizationPolicy;
+
+afterEach(function (): void {
+    setPermissionsTeamId(null);
+});
+
+it('allows any user to create organizations', function (): void {
+    $user = User::factory()->createOne();
+
+    expect(new OrganizationPolicy()->create($user))->toBeTrue();
+});
+
+it('allows members with the required permission', function (string $ability, MembershipPermission $permission): void {
+    $organization = Organization::factory()->createOne();
+    $user = login(organization: $organization);
+    $user->switchOrganization($organization);
+    $user->givePermissionTo($permission);
+
+    expect($user->can($ability, $organization))->toBeTrue();
+})->with([
+    'update' => ['update', MembershipPermission::SettingsOrganization],
+    'view' => ['view', MembershipPermission::SettingsView],
+]);
+
+it('denies members without the required permission', function (string $ability, MembershipPermission $permission): void {
+    $organization = Organization::factory()->createOne();
+    $user = login(organization: $organization);
+    $user->switchOrganization($organization);
+    $user->givePermissionTo($permission);
+
+    expect($user->can($ability, $organization))->toBeFalse();
+})->with([
+    'update' => ['update', MembershipPermission::SettingsView],
+    'view' => ['view', MembershipPermission::SettingsOrganization],
+]);
+
+it('denies members outside the organization permission context', function (): void {
+    $organization = Organization::factory()->createOne();
+    $user = login(organization: $organization);
+    $user->switchOrganization($organization);
+    $user->givePermissionTo(MembershipPermission::SettingsView);
+    setPermissionsTeamId(null);
+
+    expect($user->can('view', $organization))->toBeFalse();
+});
+
+it('denies unrelated users even with the required permission', function (string $ability, MembershipPermission $permission): void {
+    $organization = Organization::factory()->createOne();
+    $user = login();
+    setPermissionsTeamId($organization->id);
+    $user->givePermissionTo($permission);
+
+    expect($user->can($ability, $organization))->toBeFalse();
+})->with([
+    'update' => ['update', MembershipPermission::SettingsOrganization],
+    'view' => ['view', MembershipPermission::SettingsView],
+]);
+
+it('requires a permission-bearing role for an owner', function (): void {
+    $user = User::factory()->createOne();
+    $organization = Organization::factory()->for($user, 'owner')->createOne();
+    $user->switchOrganization($organization);
+
+    expect($user->can('view', $organization))->toBeFalse()
+        ->and($user->can('update', $organization))->toBeFalse();
+
+    $user->assignRole(MembershipRole::Owner);
+
+    expect($user->can('view', $organization))->toBeTrue()
+        ->and($user->can('update', $organization))->toBeTrue();
+});
