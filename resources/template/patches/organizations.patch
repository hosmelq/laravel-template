+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertDatabaseHas;
+
+use App\Actions\Organizations\Inputs\UpdateOrganizationInput;
+use App\Actions\Organizations\UpdateOrganization;
+use App\Enums\AuditLogEvent;
+use App\Models\Organization;
+use HosmelQ\AuditLog\Data\AuditLogData;
+use HosmelQ\AuditLog\Facades\AuditLog;
+
+it('updates every supported organization field', function (): void {
+    AuditLog::fake();
+
+    $organization = Organization::factory()->createOne([
+        'name' => 'My Organization',
+    ]);
+
+    $updatedOrganization = resolve(UpdateOrganization::class)->handle(
+        organization: $organization,
+        input: UpdateOrganizationInput::from([
+            'name' => 'Updated Organization',
+        ]),
+    );
+
+    expect($updatedOrganization->is($organization))->toBeTrue();
+
+    assertDatabaseHas(Organization::class, [
+        'id' => $organization->id,
+        'name' => 'Updated Organization',
+        'owner_id' => $organization->owner_id,
+    ]);
+    AuditLog::assertRecorded(fn (AuditLogData $log): bool => $log->event === AuditLogEvent::OrganizationUpdated->value
+        && $log->changes?->before['name'] === 'My Organization'
+        && $log->changes?->after['name'] === 'Updated Organization'
+        && $log->tenantId === (string) $organization->id
+        && $log->targets[0]->type === 'organization'
+        && $log->targets[0]->id === (string) $organization->id);
+});
+
+it('updates only provided organization fields', function (): void {
+    AuditLog::fake();
+
+    $organization = Organization::factory()->createOne([
+        'name' => 'My Organization',
+    ]);
+
+    resolve(UpdateOrganization::class)->handle(
+        organization: $organization,
+        input: UpdateOrganizationInput::from([]),
+    );
+
+    assertDatabaseHas(Organization::class, [
+        'id' => $organization->id,
+        'name' => 'My Organization',
+        'owner_id' => $organization->owner_id,
+    ]);
+});
