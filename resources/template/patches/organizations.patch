diff --git a/tests/Unit/Models/InvitationTest.php b/tests/Unit/Models/InvitationTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Unit/Models/InvitationTest.php
@@ -0,0 +1,69 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Enums\MembershipRole;
+use App\Models\Concerns\HasSqid;
+use App\Models\Invitation;
+use Carbon\CarbonImmutable;
+
+it('uses HasSqid trait', function (): void {
+    $traits = class_uses_recursive(Invitation::class);
+
+    expect($traits)->toContain(HasSqid::class);
+});
+
+it('correctly casts attributes', function (): void {
+    $invitation = new Invitation([
+        'accepted_at' => '2026-10-11 15:00:00',
+        'created_at' => '2026-10-10 14:00:00',
+        'expires_at' => '2026-10-17 14:00:00',
+        'role' => 'admin',
+        'updated_at' => '2026-10-11 15:00:00',
+    ]);
+
+    expect($invitation)
+        ->accepted_at->toBeInstanceOf(CarbonImmutable::class)
+        ->created_at->toBeInstanceOf(CarbonImmutable::class)
+        ->expires_at->toBeInstanceOf(CarbonImmutable::class)
+        ->role->toBe(MembershipRole::Admin)
+        ->updated_at->toBeInstanceOf(CarbonImmutable::class);
+});
+
+it('preserves a null acceptance timestamp', function (): void {
+    $invitation = new Invitation(['accepted_at' => null]);
+
+    expect($invitation->accepted_at)->toBeNull();
+});
+
+it('normalizes email addresses when assigned', function (): void {
+    $invitation = new Invitation();
+
+    $invitation->email = 'Member@Example.com';
+
+    expect($invitation->email)->toBe('member@example.com');
+});
+
+it('identifies invitations in audit logs', function (): void {
+    $invitation = new Invitation(['id' => 123]);
+
+    $identity = $invitation->auditLogIdentity();
+
+    expect($identity)
+        ->id->toBe('123')
+        ->type->toBe('invitation');
+});
+
+it('determines whether an invitation is expired', function (CarbonImmutable $expiresAt, bool $expired): void {
+    $invitation = new Invitation(['expires_at' => $expiresAt]);
+
+    expect($invitation->isExpired())->toBe($expired);
+})->with([
+    'expired' => [fn (): CarbonImmutable => now()->subSecond(), true],
+    'expires now' => [fn (): CarbonImmutable => now(), false],
+    'not expired' => [fn (): CarbonImmutable => now()->addSecond(), false],
+]);
+
+it('defaults the route key to sqid without a route key attribute', function (): void {
+    expect(new Invitation()->getRouteKeyName())->toBe('sqid');
+});
