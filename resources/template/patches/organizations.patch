@@ -0,0 +1,45 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Support;
+
+use App\Models\Organization;
+use App\Models\User;
+use Closure;
+use Spatie\Permission\PermissionRegistrar;
+
+class OrganizationPermissionContext
+{
+    public function __construct(private readonly PermissionRegistrar $permissionRegistrar)
+    {
+    }
+
+    /**
+     * @template TReturn
+     *
+     * @param Closure(): TReturn $callback
+     *
+     * @return TReturn
+     */
+    public function run(User $user, Organization $organization, Closure $callback): mixed
+    {
+        $previousTeamId = $this->permissionRegistrar->getPermissionsTeamId();
+
+        $this->permissionRegistrar->setPermissionsTeamId($organization);
+        $this->forgetPermissionRelations($user);
+
+        try {
+            return $callback();
+        } finally {
+            $this->permissionRegistrar->setPermissionsTeamId($previousTeamId);
+            $this->forgetPermissionRelations($user);
+        }
+    }
+
+    private function forgetPermissionRelations(User $user): void
+    {
+        $user->unsetRelation('permissions');
+        $user->unsetRelation('roles');
+    }
+}
