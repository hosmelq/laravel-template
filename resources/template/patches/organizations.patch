@@ -0,0 +1,70 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Middleware;
+
+use App\Models\Organization;
+use App\Models\User;
+use Closure;
+use Illuminate\Contracts\Auth\Authenticatable;
+use Illuminate\Http\Request;
+use Illuminate\Routing\Route;
+use Spatie\Permission\PermissionRegistrar;
+use Symfony\Component\HttpFoundation\Response;
+
+class SetOrganizationPermissionContext
+{
+    public function __construct(private readonly PermissionRegistrar $permissionRegistrar)
+    {
+    }
+
+    /**
+     * @param Closure(Request): (Response) $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $request->user();
+
+        $this->forgetPermissionRelations($user);
+        $this->permissionRegistrar->setPermissionsTeamId(null);
+
+        try {
+            $route = $request->route();
+            $organization = null;
+
+            if ($route instanceof Route) {
+                $organization = $route->parameter('organization');
+
+                if (is_string($organization)) {
+                    $resolvedOrganization = new Organization()->resolveRouteBinding($organization);
+
+                    if ($resolvedOrganization instanceof Organization) {
+                        $organization = $resolvedOrganization;
+
+                        $route->setParameter('organization', $organization);
+                    }
+                }
+            }
+
+            $this->permissionRegistrar->setPermissionsTeamId(
+                $organization instanceof Organization ? $organization : null,
+            );
+
+            return $next($request);
+        } finally {
+            $this->permissionRegistrar->setPermissionsTeamId(null);
+            $this->forgetPermissionRelations($user);
+        }
+    }
+
+    private function forgetPermissionRelations(null|Authenticatable $user): void
+    {
+        if (! $user instanceof User) {
+            return;
+        }
+
+        $user->unsetRelation('permissions');
+        $user->unsetRelation('roles');
+    }
+}
