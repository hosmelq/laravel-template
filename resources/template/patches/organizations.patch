+<?php
+
+declare(strict_types=1);
+
+use App\Models\Invitation;
+use App\Models\Organization;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Database\UniqueConstraintViolationException;
+
+it('finds unaccepted invitations by their plain token', function (): void {
+    $invitation = Invitation::factory()->withToken('invitation-token')->createOne();
+
+    expect($invitation->token)
+        ->toBe(hash('sha256', 'invitation-token'))
+        ->and(Invitation::findByToken('invitation-token')?->is($invitation))->toBeTrue();
+});
+
+it('returns null when the invitation token does not match', function (): void {
+    Invitation::factory()->withToken('invitation-token')->createOne();
+
+    expect(Invitation::findByToken('unknown-token'))->toBeNull();
+});
+
+it('does not find accepted invitations by token', function (): void {
+    Invitation::factory()->accepted()->withToken('invitation-token')->createOne();
+
+    expect(Invitation::findByToken('invitation-token'))->toBeNull();
+});
+
+it('finds expired invitations that have not been accepted', function (): void {
+    $invitation = Invitation::factory()->expired()->withToken('invitation-token')->createOne();
+
+    expect(Invitation::findByToken('invitation-token')?->is($invitation))->toBeTrue();
+});
+
+it('does not accept a stored token hash as a plain token', function (): void {
+    $invitation = Invitation::factory()->withToken('invitation-token')->createOne();
+
+    expect(Invitation::findByToken($invitation->token))->toBeNull();
+});
+
+it('belongs to the inviting user', function (): void {
+    $user = User::factory()->createOne();
+    $invitation = Invitation::factory()->for($user, 'invitedByUser')->createOne();
+
+    expect($invitation->invitedByUser->is($user))->toBeTrue();
+});
+
+it('belongs to an organization', function (): void {
+    $organization = Organization::factory()->createOne();
+    $invitation = Invitation::factory()->recycle($organization)->createOne();
+
+    expect($invitation->organization->is($organization))
+        ->toBeTrue()
+        ->and($invitation->invited_by_user_id)->toBe($organization->owner_id);
+});
+
+it('computes sqids without persisting them', function (): void {
+    $invitation = Invitation::factory()->createOne();
+
+    expect($invitation->sqid)
+        ->toBeString()
+        ->toHaveLength(10)
+        ->and($invitation->getAttributes())
+        ->not->toHaveKey('sqid');
+});
+
+it('finds models by sqid', function (): void {
+    $invitation = Invitation::factory()->createOne();
+
+    expect($invitation->is(Invitation::findBySqid($invitation->sqid)))
+        ->toBeTrue()
+        ->and(Invitation::findBySqid('invalid'))
+        ->toBeNull();
+});
+
+it('scopes queries by sqid', function (): void {
+    $invitation = Invitation::factory()->createOne();
+
+    expect(Invitation::query()->whereSqid($invitation->sqid)->first()?->is($invitation))->toBeTrue();
+});
+
+it('throws when sqid cannot be found', function (): void {
+    Invitation::findOrFailBySqid('invalid');
+})->throws(ModelNotFoundException::class);
+
+it('enforces token uniqueness at the database level', function (): void {
+    $invitation = Invitation::factory()->withToken('invitation-token')->createOne();
+
+    expect(fn () => Invitation::factory()
+        ->recycle($invitation->organization)
+        ->withToken('invitation-token')
+        ->createOne())->toThrow(function (UniqueConstraintViolationException $exception): void {
+            expect($exception->index)->toBe('invitations_token_unique');
+        });
+});
