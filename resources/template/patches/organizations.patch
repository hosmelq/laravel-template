+use function Pest\Laravel\assertDatabaseHas;
+
+use App\Actions\Organizations\EnsureOrganizationRoles;
+use App\Enums\MembershipRole;
+use App\Models\Organization;
+use Spatie\Permission\Models\Permission;
+use Spatie\Permission\Models\Role;
+
+it('creates the shared permission catalog and organization roles through the factory', function (): void {
+    $organization = Organization::factory()->createOne();
+
+    expect(Permission::query()->orderBy('name')->pluck('name')->all())->toBe([
+        'settings.organization',
+        'settings.view',
+        'team.manage',
+        'team.view',
+    ]);
+
+    assertDatabaseCount(Role::class, 3);
+
+    foreach (['admin', 'owner', 'viewer'] as $role) {
+        assertDatabaseHas(Role::class, [
+            'guard_name' => 'web',
+            'name' => $role,
+            'organization_id' => $organization->id,
+        ]);
+    }
+});
+
+it('assigns the exact default permissions', function (MembershipRole $membershipRole, array $permissions): void {
+    $organization = Organization::factory()->createOne();
+    $role = Role::query()
+        ->where('name', $membershipRole->value)
+        ->where('organization_id', $organization->id)
+        ->sole();
+
+    expect($role->permissions()->orderBy('name')->pluck('name')->all())->toBe($permissions);
+})->with([
+    'admin' => [MembershipRole::Admin, ['settings.organization', 'settings.view', 'team.manage', 'team.view']],
+    'owner' => [MembershipRole::Owner, ['settings.organization', 'settings.view', 'team.manage', 'team.view']],
+    'viewer' => [MembershipRole::Viewer, []],
+]);
+
+it('restores defaults without duplicating roles or permissions', function (): void {
+    $organization = Organization::factory()->createOne();
+    $role = Role::query()
+        ->where('name', 'admin')
+        ->where('organization_id', $organization->id)
+        ->sole();
+    $role->syncPermissions([]);
+
+    $roleIds = Role::query()->orderBy('id')->pluck('id')->all();
+    $permissionIds = Permission::query()->orderBy('id')->pluck('id')->all();
+
+    resolve(EnsureOrganizationRoles::class)->handle($organization);
+    resolve(EnsureOrganizationRoles::class)->handle($organization);
+
+    expect(Role::query()->orderBy('id')->pluck('id')->all())->toBe($roleIds)
+        ->and(Permission::query()->orderBy('id')->pluck('id')->all())->toBe($permissionIds)
+        ->and($role->permissions()->count())->toBe(4);
+});
+
+it('preserves another organization roles and the active permission team', function (): void {
+    $otherOrganization = Organization::factory()->createOne();
+    $organization = Organization::factory()->createOne();
+    $otherRole = Role::query()
+        ->where('name', 'admin')
+        ->where('organization_id', $otherOrganization->id)
+        ->sole();
+    $otherRole->syncPermissions(['team.view']);
+    setPermissionsTeamId($otherOrganization->id);
+
+    resolve(EnsureOrganizationRoles::class)->handle($organization);
+
+    expect($otherRole->permissions()->pluck('name')->all())->toBe(['team.view'])
+        ->and(getPermissionsTeamId())->toBe($otherOrganization->id);
+
+    assertDatabaseCount(Permission::class, 4);
+    assertDatabaseCount(Role::class, 6);
+});
+
+it('creates organization roles independently of global roles with the same name', function (MembershipRole $membershipRole): void {
+    Role::query()->create([
+        'guard_name' => 'web',
+        'name' => $membershipRole->value,
+        'organization_id' => null,
+    ]);
+
+    $organization = Organization::factory()->createOne();
+
+    assertDatabaseCount(Role::class, 4);
+    assertDatabaseHas(Role::class, [
+        'guard_name' => 'web',
+        'name' => $membershipRole->value,
+        'organization_id' => $organization->id,
+    ]);
+})->with(MembershipRole::cases());
