@@ -0,0 +1,146 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\get;
+
+use App\Enums\Permission;
+use App\Models\Organization;
+use Illuminate\Support\Facades\Exceptions;
+use Illuminate\Support\Facades\Route;
+
+it('clears existing permission context for requests without an organization', function (): void {
+    Route::middleware('web')
+        ->get('/_test/without-organization', fn (): array => [
+            'organization_id' => getPermissionsTeamId(),
+        ]);
+
+    setPermissionsTeamId(123);
+
+    $response = get('/_test/without-organization');
+
+    $response->assertExactJson([
+        'organization_id' => null,
+    ]);
+
+    expect(getPermissionsTeamId())->toBeNull();
+});
+
+it('clears existing permission context when organization binding fails', function (): void {
+    Route::middleware('web')
+        ->get('/_test/organizations/{organization}', fn (Organization $organization): string => 'ok');
+
+    setPermissionsTeamId(123);
+
+    $response = get('/_test/organizations/missing');
+
+    $response->assertNotFound();
+
+    expect(getPermissionsTeamId())->toBeNull();
+});
+
+it('clears loaded permission relations before and after a tenant request', function (): void {
+    $organization = Organization::factory()->createOne();
+    $user = loginWithPermission(Permission::OrganizationsView, $organization);
+
+    Route::middleware('web')
+        ->get('/_test/permission-relations/{organization}', fn (Organization $organization): array => [
+            'organization_id' => getPermissionsTeamId(),
+            'permissions_loaded' => $user->relationLoaded('permissions'),
+            'roles_loaded' => $user->relationLoaded('roles'),
+        ]);
+
+    setPermissionsTeamId($organization);
+    $user->load(['permissions', 'roles']);
+
+    expect($user)
+        ->relationLoaded('permissions')->toBeTrue()
+        ->relationLoaded('roles')->toBeTrue();
+
+    $response = get('/_test/permission-relations/'.$organization->getRouteKey());
+
+    $response->assertExactJson([
+        'organization_id' => $organization->id,
+        'permissions_loaded' => false,
+        'roles_loaded' => false,
+    ]);
+
+    expect(getPermissionsTeamId())
+        ->toBeNull()
+        ->and($user->relationLoaded('permissions'))
+        ->toBeFalse()
+        ->and($user->relationLoaded('roles'))
+        ->toBeFalse();
+});
+
+it('clears permission relations when a tenant request throws', function (): void {
+    Exceptions::fake();
+
+    $organization = Organization::factory()->createOne();
+    $user = loginWithPermission(Permission::OrganizationsView, $organization);
+
+    Route::middleware('web')
+        ->get(
+            '/_test/permission-relations-exception/{organization}',
+            static fn (Organization $organization): never => throw new RuntimeException('Expected test exception.'),
+        );
+
+    setPermissionsTeamId($organization);
+    $user->load(['permissions', 'roles']);
+
+    $response = get('/_test/permission-relations-exception/'.$organization->getRouteKey());
+
+    $response->assertServerError();
+    Exceptions::assertReported(RuntimeException::class);
+
+    expect(getPermissionsTeamId())
+        ->toBeNull()
+        ->and($user->relationLoaded('permissions'))
+        ->toBeFalse()
+        ->and($user->relationLoaded('roles'))
+        ->toBeFalse();
+});
+
+it('does not leak loaded roles across tenant requests', function (): void {
+    $firstOrganization = Organization::factory()->createOne();
+    $secondOrganization = Organization::factory()->createOne();
+    $user = loginWithPermission(Permission::OrganizationsView, $firstOrganization);
+
+    $user->organizations()->syncWithoutDetaching($secondOrganization);
+
+    Route::middleware('web')
+        ->get('/_test/cross-tenant-role/{organization}', fn (Organization $organization): array => [
+            'authorized' => $user->canInOrganization($organization, Permission::OrganizationsView),
+        ]);
+
+    setPermissionsTeamId($firstOrganization);
+    $user->load('roles');
+
+    $response = get('/_test/cross-tenant-role/'.$secondOrganization->getRouteKey());
+
+    $response->assertExactJson([
+        'authorized' => false,
+    ]);
+
+    expect(getPermissionsTeamId())
+        ->toBeNull()
+        ->and($user->relationLoaded('roles'))
+        ->toBeFalse();
+});
+
+it('sets and clears the organization permission context for web requests', function (): void {
+    Route::middleware('web')
+        ->get('/_test/organizations/{organization}', fn (Organization $organization): array => [
+            'organization_id' => getPermissionsTeamId(),
+        ]);
+
+    $organization = Organization::factory()->createOne();
+
+    $response = get('/_test/organizations/'.$organization->getRouteKey());
+
+    $response->assertExactJson([
+        'organization_id' => $organization->id,
+    ]);
+
+    expect(getPermissionsTeamId())->toBeNull();
+});
