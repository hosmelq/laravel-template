+<?php
+
+declare(strict_types=1);
+
+namespace Database\Seeders;
+
+use App\Enums\OrganizationRole;
+use App\Enums\Permission;
+use Illuminate\Database\Seeder;
+use Spatie\Permission\Models\Permission as PermissionModel;
+use Spatie\Permission\Models\Role as RoleModel;
+use Spatie\Permission\PermissionRegistrar;
+
+class RolesAndPermissionsSeeder extends Seeder
+{
+    private const string GUARD_NAME = 'web';
+
+    public function run(PermissionRegistrar $permissionRegistrar): void
+    {
+        $previousTeamId = $permissionRegistrar->getPermissionsTeamId();
+
+        try {
+            $permissionRegistrar->setPermissionsTeamId(null);
+            $permissionRegistrar->forgetCachedPermissions();
+
+            foreach (Permission::cases() as $permission) {
+                PermissionModel::findOrCreate($permission, self::GUARD_NAME);
+            }
+
+            foreach (OrganizationRole::cases() as $role) {
+                RoleModel::findOrCreate($role, self::GUARD_NAME);
+
+                $globalRole = RoleModel::query()
+                    ->where('guard_name', self::GUARD_NAME)
+                    ->where('name', $role->value)
+                    ->whereNull($permissionRegistrar->teamsKey)
+                    ->sole();
+
+                $globalRole->syncPermissions($role->permissions());
+            }
+        } finally {
+            $permissionRegistrar->setPermissionsTeamId($previousTeamId);
+            $permissionRegistrar->forgetCachedPermissions();
+        }
+    }
+}
