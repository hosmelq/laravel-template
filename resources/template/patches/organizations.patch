+<?php
+
+declare(strict_types=1);
+
+namespace App\Actions\Organizations;
+
+use function HosmelQ\AuditLog\audit_log;
+
+use App\Actions\Organizations\Inputs\UpdateOrganizationInput;
+use App\Enums\AuditLogEvent;
+use App\Models\Organization;
+use Illuminate\Support\Arr;
+use Illuminate\Support\Facades\DB;
+
+class UpdateOrganization
+{
+    public function handle(Organization $organization, UpdateOrganizationInput $input): Organization
+    {
+        return DB::transaction(function () use ($input, $organization): Organization {
+            $organization->update($input->transform());
+
+            /** @var array<string, null|bool|float|int|string> $before */
+            $before = Arr::except($organization->getPrevious(), 'updated_at');
+            /** @var array<string, null|bool|float|int|string> $after */
+            $after = Arr::except($organization->getChanges(), 'updated_at');
+
+            audit_log(AuditLogEvent::OrganizationUpdated)
+                ->changes(before: $before, after: $after)
+                ->target($organization)
+                ->tenant($organization->id)
+                ->record();
+
+            return $organization;
+        });
+    }
+}
