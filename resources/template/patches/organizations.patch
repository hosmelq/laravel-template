+<?php
+
+declare(strict_types=1);
+
+use App\Models\Organization;
+use HosmelQ\AuditLog\AuditLogContext;
+
+it('resolves audit tenancy from the authenticated user as organizations change', function (): void {
+    $firstOrganization = Organization::factory()->createOne();
+    $secondOrganization = Organization::factory()->createOne();
+    $user = login(organization: $firstOrganization);
+    $user->organizations()->attach($secondOrganization);
+    $context = resolve(AuditLogContext::class);
+
+    expect($context->tenant())->toBe((string) $firstOrganization->id);
+
+    $user->switchOrganization($secondOrganization);
+
+    expect($context->tenant())->toBe((string) $secondOrganization->id);
+});
+
+it('resolves no audit tenant for guests or users without an organization', function (): void {
+    $context = resolve(AuditLogContext::class);
+
+    expect($context->tenant())->toBeEmpty();
+
+    login();
+
+    expect($context->tenant())->toBeEmpty();
+});
