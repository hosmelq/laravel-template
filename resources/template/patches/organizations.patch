+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertDatabaseHas;
+
+use App\Actions\Organizations\CreateOrganization;
+use App\Actions\Organizations\Inputs\CreateOrganizationInput;
+use App\Models\Organization;
+use App\Models\User;
+
+it('creates an organization for the user and switches to it', function (): void {
+    $user = User::factory()->createOne();
+
+    $organization = resolve(CreateOrganization::class)->handle(
+        user: $user,
+        input: CreateOrganizationInput::from([
+            'name' => 'My Organization',
+        ]),
+    );
+
+    expect($organization)->toBeInstanceOf(Organization::class);
+
+    assertDatabaseHas(Organization::class, [
+        'name' => 'My Organization',
+        'owner_id' => $user->id,
+    ]);
+
+    $user->refresh();
+
+    expect($user)
+        ->current_organization_id->toBe($organization->id)
+        ->belongsToOrganization($organization)->toBeTrue()
+        ->and($organization->owner->is($user))->toBeTrue()
+        ->and($organization->users)->toHaveCount(1);
+});
