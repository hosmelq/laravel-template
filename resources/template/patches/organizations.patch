+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Middleware;
+
+use App\Models\Organization;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class SetOrganizationPermissionContext
+{
+    /**
+     * @param Closure(Request): (Response) $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        try {
+            $user = $request->user();
+
+            if ($user !== null && $user->current_organization_id === null && ($defaultOrganization = $user->defaultOrganization()) !== null) {
+                $user->switchOrganization($defaultOrganization);
+            }
+
+            $activeOrganization = $user?->currentOrganization;
+
+            setPermissionsTeamId($activeOrganization?->id);
+
+            $organization = $request->route('organization');
+
+            if ($user !== null && $organization instanceof Organization) {
+                abort_unless($user->isCurrentOrganization($organization), 403);
+            }
+
+            return $next($request);
+        } finally {
+            setPermissionsTeamId(null);
+        }
+    }
+}
