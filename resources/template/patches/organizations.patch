+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertDatabaseHas;
+use function Pest\Laravel\getJson;
+
+use App\Models\Organization;
+use App\Models\User;
+use Illuminate\Support\Facades\Exceptions;
+use Illuminate\Support\Facades\Route;
+
+it('uses the active organization and clears the team after the request', function (): void {
+    $user = User::factory()
+        ->withOrganization()
+        ->createOne();
+
+    login($user);
+
+    Route::middleware('web')
+        ->get('/_test/permission-context', fn (): array => ['team_id' => getPermissionsTeamId()]);
+
+    $response = getJson('/_test/permission-context');
+
+    $response->assertExactJson(['team_id' => $user->current_organization_id]);
+
+    expect(getPermissionsTeamId())
+        ->toBeNull();
+});
+
+it('assigns the first organization and its permission team when no organization is active', function (): void {
+    $user = User::factory()
+        ->has(
+            Organization::factory()
+                ->count(2),
+            'organizations',
+        )
+        ->createOne();
+    $organization = $user->organizations->first();
+
+    $user->load('currentOrganization');
+    login($user);
+    setPermissionsTeamId(123);
+
+    Route::middleware('web')
+        ->get('/_test/permission-context', fn (): array => ['team_id' => getPermissionsTeamId()]);
+
+    $response = getJson('/_test/permission-context');
+
+    $response->assertExactJson(['team_id' => $organization->id]);
+
+    expect($user->currentOrganization)
+        ->is($organization)
+        ->toBeTrue()
+        ->and($user->current_organization_id)
+        ->toBe($organization->id)
+        ->and(getPermissionsTeamId())
+        ->toBeNull();
+
+    assertDatabaseHas(User::class, [
+        'current_organization_id' => $organization->id,
+        'id' => $user->id,
+    ]);
+});
+
+it('clears a previous team for guests', function (): void {
+    setPermissionsTeamId(123);
+
+    Route::middleware('web')
+        ->get('/_test/permission-context', fn (): array => ['team_id' => getPermissionsTeamId()]);
+
+    $response = getJson('/_test/permission-context');
+
+    $response->assertExactJson(['team_id' => null]);
+
+    expect(getPermissionsTeamId())
+        ->toBeNull();
+});
+
+it('uses no team for a user without an active organization', function (): void {
+    login();
+    setPermissionsTeamId(123);
+
+    Route::middleware('web')
+        ->get('/_test/permission-context', fn (): array => ['team_id' => getPermissionsTeamId()]);
+
+    $response = getJson('/_test/permission-context');
+
+    $response->assertExactJson(['team_id' => null]);
+
+    expect(getPermissionsTeamId())
+        ->toBeNull();
+});
+
+it('uses the active organization instead of the organization in the URL', function (): void {
+    $user = User::factory()
+        ->withOrganization()
+        ->createOne();
+    $activeOrganizationId = $user->current_organization_id;
+    $urlOrganization = Organization::factory()
+        ->recycle($user)
+        ->createOne();
+
+    login($user);
+
+    Route::middleware('web')
+        ->get('/_test/organizations/{organization}', fn (Organization $organization): array => [
+            'organization_id' => $organization->id,
+            'team_id' => getPermissionsTeamId(),
+        ]);
+
+    $response = getJson('/_test/organizations/'.$urlOrganization->getRouteKey());
+
+    $response->assertForbidden();
+
+    assertDatabaseHas(User::class, [
+        'current_organization_id' => $activeOrganizationId,
+        'id' => $user->id,
+    ]);
+
+    expect(getPermissionsTeamId())
+        ->toBeNull();
+});
+
+it('clears the active team when the request throws an exception', function (): void {
+    Exceptions::fake();
+
+    $user = User::factory()
+        ->withOrganization()
+        ->createOne();
+
+    login($user);
+
+    Route::middleware('web')
+        ->get('/_test/permission-context', function () use ($user): never {
+            expect(getPermissionsTeamId())
+                ->toBe($user->current_organization_id);
+
+            throw new RuntimeException('Permission context request failed.');
+        });
+
+    $response = getJson('/_test/permission-context');
+
+    $response->assertInternalServerError();
+
+    Exceptions::assertReported(RuntimeException::class);
+
+    expect(getPermissionsTeamId())
+        ->toBeNull();
+});
+
+it('allows requests for the active organization after route model binding', function (): void {
+    $organization = Organization::factory()
+        ->createOne();
+
+    $user = login(organization: $organization);
+
+    Route::middleware('web')
+        ->get('/_test/organizations/{organization}', fn (Organization $organization): array => [
+            'organization_id' => $organization->id,
+            'team_id' => getPermissionsTeamId(),
+        ]);
+
+    $response = getJson('/_test/organizations/'.$organization->getRouteKey());
+
+    $response->assertExactJson([
+        'organization_id' => $organization->id,
+        'team_id' => $organization->id,
+    ]);
+
+    assertDatabaseHas(User::class, [
+        'current_organization_id' => $organization->id,
+        'id' => $user->id,
+    ]);
+
+    expect(getPermissionsTeamId())
+        ->toBeNull();
+});
+
+it('forbids requests for another membership without switching the active organization', function (): void {
+    $activeOrganization = Organization::factory()
+        ->createOne();
+    $otherOrganization = Organization::factory()
+        ->createOne();
+
+    $user = login(organization: $activeOrganization);
+    $user->organizations()
+        ->attach($otherOrganization);
+
+    Route::middleware('web')
+        ->get('/_test/organizations/{organization}', fn (Organization $organization): array => [
+            'organization_id' => $organization->id,
+        ]);
+
+    $response = getJson('/_test/organizations/'.$otherOrganization->getRouteKey());
+
+    $response->assertForbidden();
+
+    expect($user->current_organization_id)
+        ->toBe($activeOrganization->id)
+        ->and(getPermissionsTeamId())
+        ->toBeNull();
+
+    assertDatabaseHas(User::class, [
+        'current_organization_id' => $activeOrganization->id,
+        'id' => $user->id,
+    ]);
+});
+
+it('resolves the default organization before checking the route when the user has no active organization', function (): void {
+    $organization = Organization::factory()
+        ->createOne();
+
+    $user = login();
+    $user->organizations()
+        ->attach($organization);
+
+    Route::middleware('web')
+        ->get('/_test/organizations/{organization}', fn (Organization $organization): array => [
+            'organization_id' => $organization->id,
+            'team_id' => getPermissionsTeamId(),
+        ]);
+
+    $response = getJson('/_test/organizations/'.$organization->getRouteKey());
+
+    $response->assertExactJson([
+        'organization_id' => $organization->id,
+        'team_id' => $organization->id,
+    ]);
+
+    assertDatabaseHas(User::class, [
+        'current_organization_id' => $organization->id,
+        'id' => $user->id,
+    ]);
+
+    expect(getPermissionsTeamId())
+        ->toBeNull();
+});
+
+it('forbids another membership after resolving the default organization without switching to the route organization', function (): void {
+    $defaultOrganization = Organization::factory()
+        ->createOne();
+    $otherOrganization = Organization::factory()
+        ->createOne();
+
+    $user = login();
+    $user->organizations()
+        ->attach($defaultOrganization);
+    $user->organizations()
+        ->attach($otherOrganization);
+    $user->load('organizations');
+
+    Route::middleware('web')
+        ->get('/_test/organizations/{organization}', fn (Organization $organization): array => [
+            'organization_id' => $organization->id,
+        ]);
+
+    $response = getJson('/_test/organizations/'.$otherOrganization->getRouteKey());
+
+    $response->assertForbidden();
+
+    expect($user->current_organization_id)
+        ->toBe($defaultOrganization->id);
+
+    assertDatabaseHas(User::class, [
+        'current_organization_id' => $defaultOrganization->id,
+        'id' => $user->id,
+    ]);
+
+    expect(getPermissionsTeamId())
+        ->toBeNull();
+});
+
+it('leaves guests unaffected', function (): void {
+    $organization = Organization::factory()
+        ->createOne();
+
+    Route::middleware('web')
+        ->get('/_test/organizations/{organization}', fn (Organization $organization): array => [
+            'organization_id' => $organization->id,
+        ]);
+
+    $response = getJson('/_test/organizations/'.$organization->getRouteKey());
+
+    $response->assertExactJson(['organization_id' => $organization->id]);
+});
+
+it('leaves routes without an organization parameter unaffected', function (): void {
+    login();
+
+    Route::middleware('web')
+        ->get('/_test/organizations', fn (): array => ['allowed' => true]);
+
+    $response = getJson('/_test/organizations');
+
+    $response->assertExactJson(['allowed' => true]);
+});
diff --git a/tests/Feature/Models/OrganizationRouteKeyTest.php b/tests/Feature/Models/OrganizationRouteKeyTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Feature/Models/OrganizationRouteKeyTest.php
@@ -0,0 +1,24 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\get;
+
+use App\Models\Organization;
+use Illuminate\Routing\Middleware\SubstituteBindings;
+use Illuminate\Support\Facades\Route;
+
+it('binds organizations by slug while retaining explicit sqid bindings', function (): void {
+    $organization = Organization::factory()->createOne();
+
+    Route::middleware(SubstituteBindings::class)
+        ->get('/_organization/{organization}', fn (Organization $organization): string => $organization->slug);
+
+    Route::middleware(SubstituteBindings::class)
+        ->get('/_sqid/{organization:sqid}', fn (Organization $organization): string => $organization->sqid);
+
+    get('/_organization/'.$organization->slug)->assertOk()->assertSeeText($organization->slug);
+    get('/_organization/'.$organization->sqid)->assertNotFound();
+    get('/_sqid/'.$organization->sqid)->assertOk()->assertSeeText($organization->sqid);
+    get('/_sqid/'.$organization->id)->assertNotFound();
+});
diff --git a/tests/Integration/Actions/AcceptInvitationTest.php b/tests/Integration/Actions/AcceptInvitationTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Integration/Actions/AcceptInvitationTest.php
@@ -0,0 +1,205 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertDatabaseCount;
+use function Pest\Laravel\assertDatabaseHas;
+use function Pest\Laravel\assertDatabaseMissing;
+
+use App\Actions\Invitations\AcceptInvitation;
+use App\Actions\Organizations\EnsureOrganizationRoles;
+use App\Enums\AuditLogEvent;
+use App\Enums\MembershipRole;
+use App\Models\Invitation;
+use App\Models\User;
+use HosmelQ\AuditLog\Data\AuditLogData;
+use HosmelQ\AuditLog\Facades\AuditLog;
+use Spatie\Permission\Exceptions\RoleDoesNotExist;
+use Spatie\Permission\Models\Role;
+
+it('accepts an invitation for the user and switches to its organization', function (): void {
+    AuditLog::fake();
+
+    $user = User::factory()->createOne();
+    $invitation = Invitation::factory()->createOne(['email' => $user->email]);
+
+    resolve(EnsureOrganizationRoles::class)
+        ->handle($invitation->organization);
+
+    resolve(AcceptInvitation::class)->handle($user, $invitation);
+
+    $user->refresh();
+    $invitation->refresh();
+
+    expect($user)
+        ->belongsToOrganization($invitation->organization)->toBeTrue()
+        ->current_organization_id->toBe($invitation->organization_id)
+        ->and($invitation->accepted_at)->toEqual(now());
+
+    AuditLog::assertRecorded(fn (AuditLogData $log): bool => $log->event === AuditLogEvent::InvitationAccepted->value
+        && $log->changes?->before['accepted_at'] === null
+        && $log->changes?->after['accepted_at'] !== null
+        && $log->tenantId === (string) $invitation->organization_id
+        && $log->targets[0]->id === (string) $invitation->id);
+});
+
+it('accepts an invitation and switches organizations when memberships are already loaded', function (): void {
+    AuditLog::fake();
+
+    $user = User::factory()
+        ->withOrganization()
+        ->createOne();
+    $invitation = Invitation::factory()->createOne(['email' => $user->email]);
+
+    $user->load('organizations');
+
+    resolve(EnsureOrganizationRoles::class)
+        ->handle($invitation->organization);
+
+    resolve(AcceptInvitation::class)->handle($user, $invitation);
+
+    expect($user)
+        ->belongsToOrganization($invitation->organization)
+        ->toBeTrue()
+        ->current_organization_id->toBe($invitation->organization_id)
+        ->currentOrganization->is($invitation->organization)
+        ->toBeTrue()
+        ->and($user->fresh())
+        ->current_organization_id->toBe($invitation->organization_id)
+        ->and($invitation->fresh())
+        ->accepted_at->toEqual(now());
+
+    AuditLog::assertRecorded(fn (AuditLogData $log): bool => $log->event === AuditLogEvent::InvitationAccepted->value
+        && $log->tenantId === (string) $invitation->organization_id
+        && $log->targets[0]->id === (string) $invitation->id);
+});
+
+it('accepts an invitation without duplicating an existing membership', function (): void {
+    AuditLog::fake();
+
+    $user = User::factory()->createOne();
+    $invitation = Invitation::factory()->createOne(['email' => $user->email]);
+
+    $invitation->organization->users()->attach($user);
+
+    resolve(EnsureOrganizationRoles::class)
+        ->handle($invitation->organization);
+
+    resolve(AcceptInvitation::class)->handle($user, $invitation);
+
+    assertDatabaseCount('organization_user', 1);
+
+    expect($user->fresh())
+        ->current_organization_id->toBe($invitation->organization_id)
+        ->and($invitation->fresh())->accepted_at->toEqual(now());
+
+    AuditLog::assertRecorded(fn (AuditLogData $log): bool => $log->event === AuditLogEvent::InvitationAccepted->value
+        && $log->tenantId === (string) $invitation->organization_id
+        && $log->targets[0]->id === (string) $invitation->id);
+});
+
+it('assigns the invited role only in its organization and keeps its permission team active', function (MembershipRole $membershipRole): void {
+    $user = User::factory()
+        ->withOrganization()
+        ->createOne();
+    $otherOrganization = $user->currentOrganization;
+    $invitation = Invitation::factory()
+        ->createOne([
+            'email' => $user->email,
+            'role' => $membershipRole,
+        ]);
+    $action = resolve(EnsureOrganizationRoles::class);
+
+    $action->handle($otherOrganization);
+    $action->handle($invitation->organization);
+
+    $user->switchOrganization($otherOrganization);
+    $user->assignRole(MembershipRole::Viewer);
+    $user->load(['permissions', 'roles']);
+
+    resolve(AcceptInvitation::class)
+        ->handle($user, $invitation);
+
+    $role = Role::query()
+        ->where('name', $membershipRole->value)
+        ->where('organization_id', $invitation->organization_id)
+        ->sole();
+    $otherRole = Role::query()
+        ->where('name', MembershipRole::Viewer->value)
+        ->where('organization_id', $otherOrganization->id)
+        ->sole();
+
+    assertDatabaseCount('model_has_roles', 2);
+    assertDatabaseHas('model_has_roles', [
+        'model_id' => $user->id,
+        'model_type' => $user->getMorphClass(),
+        'organization_id' => $invitation->organization_id,
+        'role_id' => $role->id,
+    ]);
+    assertDatabaseHas('model_has_roles', [
+        'model_id' => $user->id,
+        'model_type' => $user->getMorphClass(),
+        'organization_id' => $otherOrganization->id,
+        'role_id' => $otherRole->id,
+    ]);
+    assertDatabaseMissing('model_has_roles', [
+        'model_id' => $user->id,
+        'organization_id' => $otherOrganization->id,
+        'role_id' => $role->id,
+    ]);
+
+    expect(getPermissionsTeamId())
+        ->toBe($invitation->organization_id)
+        ->and($user)
+        ->current_organization_id
+        ->toBe($invitation->organization_id)
+        ->relationLoaded('permissions')
+        ->toBeFalse()
+        ->relationLoaded('roles')
+        ->toBeFalse()
+        ->hasRole($membershipRole)
+        ->toBeTrue();
+})
+    ->with([
+        'admin' => MembershipRole::Admin,
+        'owner' => MembershipRole::Owner,
+        'viewer' => MembershipRole::Viewer,
+    ]);
+
+it('rolls back acceptance when the invited role is missing', function (): void {
+    $user = User::factory()
+        ->withOrganization()
+        ->createOne();
+    $otherOrganization = $user->currentOrganization;
+    $invitation = Invitation::factory()
+        ->createOne(['email' => $user->email]);
+
+    Role::query()
+        ->where('name', $invitation->role->value)
+        ->where('organization_id', $invitation->organization_id)
+        ->sole()
+        ->delete();
+
+    $user->switchOrganization($otherOrganization);
+
+    expect(function () use ($invitation, $user): void {
+        resolve(AcceptInvitation::class)
+            ->handle($user, $invitation);
+    })
+        ->toThrow(RoleDoesNotExist::class);
+
+    assertDatabaseMissing('organization_user', [
+        'organization_id' => $invitation->organization_id,
+        'user_id' => $user->id,
+    ]);
+    assertDatabaseCount('model_has_roles', 0);
+
+    expect(getPermissionsTeamId())
+        ->toBe($invitation->organization_id)
+        ->and($user->fresh())
+        ->current_organization_id
+        ->toBe($otherOrganization->id)
+        ->and($invitation->fresh())
+        ->accepted_at
+        ->toBeNull();
+});
