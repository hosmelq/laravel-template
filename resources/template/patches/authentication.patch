+++ b/tests/Feature/Http/EmailVerificationTest.php
@@ -0,0 +1,88 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\getJson;
+use function Pest\Laravel\postJson;
+
+use App\Enums\AuditLogEvent;
+use App\Models\User;
+use HosmelQ\AuditLog\Data\AuditLogData;
+use HosmelQ\AuditLog\Facades\AuditLog;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+it('rejects an unauthenticated verification notification with 401', function (): void {
+    Notification::fake();
+
+    postJson(route('verification.send'))->assertUnauthorized();
+
+    Notification::assertNothingSent();
+});
+
+it('sends the verification notification to the authenticated account through JSON', function (): void {
+    Notification::fake();
+    $user = login(User::factory()->unverified()->createOne());
+
+    postJson(route('verification.send'))->assertStatus(202);
+
+    Notification::assertSentTo(
+        $user,
+        VerifyEmail::class,
+        function (VerifyEmail $notification) use ($user): bool {
+            $url = $notification->toMail($user)->actionUrl;
+
+            expect($url)->toContain('/email/verify/'.$user->id.'/'.sha1($user->email));
+
+            return URL::hasValidSignature(Request::create($url));
+        },
+    );
+});
+
+it('returns a localized 429 after six verification notifications', function (): void {
+    Notification::fake();
+    $user = login(User::factory()->unverified()->createOne());
+
+    foreach (range(1, 6) as $attempt) {
+        postJson(route('verification.send'))->assertStatus(202);
+    }
+
+    postJson(route('verification.send'))->assertTooManyRequests()->assertExactJson([
+        'errors' => ['verification' => ['Too many attempts. Try again in a minute.']],
+        'message' => 'Too many attempts. Try again in a minute.',
+    ]);
+
+    Notification::assertSentToTimes($user, VerifyEmail::class, 6);
+});
+
+it('does not resend verification to an already verified account', function (): void {
+    Notification::fake();
+    login();
+
+    postJson(route('verification.send'))->assertNoContent();
+
+    Notification::assertNothingSent();
+});
+
+it('verifies the email through a signed JSON request and records the attribute change', function (): void {
+    AuditLog::fake();
+    $user = login(User::factory()->unverified()->createOne());
+    $url = URL::temporarySignedRoute('verification.verify', now()->addHour(), [
+        'hash' => sha1($user->email),
+        'id' => $user->id,
+    ]);
+
+    getJson($url)->assertNoContent();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeTrue();
+    AuditLog::assertRecorded(
+        fn (AuditLogData $log): bool => $log->event === AuditLogEvent::AuthEmailVerified->value
+            && $log->actor->id === (string) $user->id
+            && $log->changes?->before === ['email_verified_at' => null]
+            && $log->changes->after === ['email_verified_at' => now()->format('Y-m-d H:i:s')]
+            && $log->targets[0]->id === (string) $user->id
+            && $log->tenantId === '',
+    );
+});
