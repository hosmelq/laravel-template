+<?php
+
+declare(strict_types=1);
+
+namespace App\Listeners;
+
+use function HosmelQ\AuditLog\audit_log;
+
+use App\Enums\AuditLogEvent;
+use App\Models\User;
+use Illuminate\Auth\Events\Failed;
+use Illuminate\Support\Arr;
+use Laravel\Fortify\Fortify;
+
+class RecordFailedLogin
+{
+    public function handle(Failed $event): void
+    {
+        $log = audit_log(AuditLogEvent::AuthLoginFailed)->metadata([
+            'email' => Arr::string($event->credentials, Fortify::username(), ''),
+        ]);
+
+        if ($event->user instanceof User) {
+            $log->actor($event->user)->target($event->user);
+        }
+
+        $log->record();
+    }
+}
