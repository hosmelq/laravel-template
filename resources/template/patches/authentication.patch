+
+namespace App\Listeners;
+
+use function HosmelQ\AuditLog\audit_log;
+
+use App\Enums\AuditLogEvent;
+use App\Models\User;
+use Illuminate\Auth\Events\Verified;
+use Illuminate\Support\Arr;
+
+class RecordVerifiedEmail
+{
+    public function handle(Verified $event): void
+    {
+        if (! $event->user instanceof User) {
+            return;
+        }
+
+        $log = audit_log(AuditLogEvent::AuthEmailVerified);
+
+        if ($event->user->wasChanged('email_verified_at')) {
+            /** @var array<string, null|bool|float|int|string> $before */
+            $before = Arr::only($event->user->getPrevious(), 'email_verified_at');
+            /** @var array<string, null|bool|float|int|string> $after */
+            $after = Arr::only($event->user->getChanges(), 'email_verified_at');
+
+            $log->changes(before: $before, after: $after);
+        }
+
+        $log->actor($event->user)->target($event->user)->record();
+    }
+}
diff --git a/app/Providers/FortifyServiceProvider.php b/app/Providers/FortifyServiceProvider.php
new file mode 100644
--- /dev/null
+++ b/app/Providers/FortifyServiceProvider.php
@@ -0,0 +1,83 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Providers;
+
+use App\Actions\Fortify\CreateNewUser;
+use App\Actions\Fortify\ResetUserPassword;
+use App\Actions\Fortify\UpdateUserPassword;
+use App\Actions\Fortify\UpdateUserProfileInformation;
+use App\Models\User;
+use Illuminate\Auth\Events\Lockout;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Cache\RateLimiting\Limit;
+use Illuminate\Http\Request;
+use Illuminate\Support\Arr;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Lang;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\ServiceProvider;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use InvalidArgumentException;
+use Laravel\Fortify\Actions\RedirectIfTwoFactorAuthenticatable;
+use Laravel\Fortify\Fortify;
+
+class FortifyServiceProvider extends ServiceProvider
+{
+    public function boot(): void
+    {
+        Fortify::createUsersUsing(CreateNewUser::class);
+        Fortify::redirectUserForTwoFactorAuthenticationUsing(
+            RedirectIfTwoFactorAuthenticatable::class,
+        );
+        Fortify::resetUserPasswordsUsing(ResetUserPassword::class);
+        Fortify::updateUserPasswordsUsing(UpdateUserPassword::class);
+        Fortify::updateUserProfileInformationUsing(UpdateUserProfileInformation::class);
+
+        ResetPassword::createUrlUsing(function (mixed $notifiable, string $token): string {
+            throw_unless($notifiable instanceof User, InvalidArgumentException::class);
+
+            return url(mb_rtrim(config()->string('fortify.prefix'), '/').'/reset-password/'.$token)
+                .'?'.http_build_query(['email' => $notifiable->getEmailForPasswordReset()]);
+        });
+
+        RateLimiter::for('login', function (Request $request) {
+            $throttleKey = Str::transliterate(sprintf(
+                '%s|%s',
+                Str::lower((string) $request->string(Fortify::username())),
+                $request->ip(),
+            ));
+
+            return Limit::perMinute(5)->by($throttleKey)->response(
+                function (Request $request, array $headers): never {
+                    $seconds = Arr::integer($headers, 'Retry-After');
+
+                    Event::dispatch(new Lockout($request));
+
+                    throw ValidationException::withMessages([
+                        Fortify::username() => [Lang::string('auth.throttle', [
+                            'minutes' => ceil($seconds / 60),
+                            'seconds' => $seconds,
+                        ])],
+                    ])->status(429);
+                },
+            );
+        });
+
+        RateLimiter::for('two-factor', function (Request $request) {
+            return Limit::perMinute(5)->by($request->session()->get('login.id'));
+        });
+
+        RateLimiter::for('verification', function (Request $request): Limit {
+            return Limit::perMinute(6)
+                ->by($request->user()?->id)
+                ->response(function (): never {
+                    throw ValidationException::withMessages([
+                        'verification' => Lang::string('auth.verification_throttled'),
+                    ])->status(429);
+                });
+        });
+    }
+}
