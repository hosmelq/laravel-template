@@ -0,0 +1,96 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertDatabaseMissing;
+use function Pest\Laravel\postJson;
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+use Illuminate\Support\Facades\Route;
+
+it('rejects an unknown reset email with 422', function (): void {
+    Notification::fake();
+
+    postJson(route('password.email'), ['email' => 'missing@example.com'])
+        ->assertUnprocessable()
+        ->assertJsonValidationErrors(['email' => "We can't find an account with that email."]);
+
+    Notification::assertNothingSent();
+});
+
+it('sends a usable reset notification without registering a view route', function (): void {
+    Notification::fake();
+    $user = User::factory()->createOne(['email' => 'reset+test@example.com']);
+
+    postJson(route('password.email'), ['email' => $user->email])
+        ->assertOk()->assertExactJson(['message' => 'We have emailed your password reset link.']);
+
+    expect(Route::has('password.reset'))->toBeFalse();
+    Notification::assertSentTo(
+        $user,
+        ResetPassword::class,
+        function (ResetPassword $notification) use ($user): bool {
+            expect($notification->toMail($user)->actionUrl)
+                ->toBe(
+                    url('/reset-password/'.$notification->token)
+                        .'?email=reset%2Btest%40example.com',
+                );
+
+            return Password::tokenExists($user, $notification->token);
+        },
+    );
+});
+
+it('throttles repeated reset notifications with 422', function (): void {
+    Notification::fake();
+    $user = User::factory()->createOne();
+    postJson(route('password.email'), ['email' => $user->email])->assertOk();
+
+    postJson(route('password.email'), ['email' => $user->email])
+        ->assertUnprocessable()->assertJsonValidationErrors([
+            'email' => 'Wait a moment before trying again.',
+        ]);
+
+    Notification::assertSentToTimes($user, ResetPassword::class, 1);
+});
+
+it('rejects an invalid or expired reset token with 422 without changing the password', function (
+    bool $expired,
+): void {
+    $user = User::factory()->createOne();
+    $token = $expired ? Password::createToken($user) : 'invalid-token';
+
+    if ($expired) {
+        $this->travel(config()->integer('auth.passwords.users.expire') + 1)->minutes();
+    }
+
+    postJson(route('password.update'), [
+        'email' => $user->email,
+        'password' => 'new-password',
+        'password_confirmation' => 'new-password',
+        'token' => $token,
+    ])->assertUnprocessable()->assertJsonValidationErrors([
+        'email' => 'This password reset link is invalid or has expired. Request a new one.',
+    ]);
+
+    expect(Hash::check('password', $user->refresh()->password))->toBeTrue();
+})->with(['expired' => true, 'invalid' => false]);
+
+it('resets the password through JSON and consumes the token', function (): void {
+    $user = User::factory()->createOne();
+    $token = Password::createToken($user);
+
+    postJson(route('password.update'), [
+        'email' => $user->email,
+        'password' => 'new-password',
+        'password_confirmation' => 'new-password',
+        'token' => $token,
+    ])->assertOk()->assertExactJson(['message' => 'Your password has been reset.']);
+
+    expect(Hash::check('new-password', $user->refresh()->password))->toBeTrue();
+    assertDatabaseMissing('password_reset_tokens', ['email' => $user->email]);
+});
