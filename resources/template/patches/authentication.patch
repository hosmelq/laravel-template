@@ -0,0 +1,103 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertAuthenticatedAs;
+use function Pest\Laravel\assertGuest;
+use function Pest\Laravel\postJson;
+use function Pest\Laravel\travel;
+
+use App\Enums\AuditLogEvent;
+use App\Models\User;
+use HosmelQ\AuditLog\Data\AuditLogData;
+use HosmelQ\AuditLog\Facades\AuditLog;
+
+it('rejects incorrect credentials with 422 and records the failed login', function (): void {
+    AuditLog::fake();
+    $user = User::factory()->createOne();
+
+    postJson(route('login.store'), [
+        'email' => $user->email,
+        'password' => 'incorrect-password',
+    ])->assertUnprocessable()->assertJsonValidationErrors('email');
+
+    assertGuest();
+    AuditLog::assertRecorded(
+        fn (AuditLogData $log): bool => $log->event === AuditLogEvent::AuthLoginFailed->value
+            && $log->actor->id === (string) $user->id
+            && $log->metadata === ['email' => $user->email]
+            && $log->targets[0]->id === (string) $user->id
+            && $log->tenantId === '',
+    );
+});
+
+it('returns a localized 429 after five attempts and allows login after the limit expires', function (): void {
+    AuditLog::fake();
+    $user = User::factory()->createOne();
+
+    foreach (range(1, 5) as $attempt) {
+        postJson(route('login.store'), [
+            'email' => $user->email,
+            'password' => 'incorrect-password',
+        ])->assertUnprocessable();
+    }
+
+    postJson(route('login.store'), [
+        'email' => mb_strtoupper($user->email),
+        'password' => 'password',
+    ])->assertTooManyRequests()->assertExactJson([
+        'errors' => ['email' => ['Too many login attempts. Please try again in 60 seconds.']],
+        'message' => 'Too many login attempts. Please try again in 60 seconds.',
+    ]);
+
+    assertGuest();
+    AuditLog::assertRecorded(
+        fn (AuditLogData $log): bool => $log->event === AuditLogEvent::AuthLockout->value
+            && mb_strtolower($log->metadata['email']) === $user->email
+            && $log->targets === []
+            && $log->tenantId === '',
+    );
+    AuditLog::assertRecordedTimes(AuditLogEvent::AuthLoginFailed, 5);
+
+    travel(61)->seconds();
+
+    postJson(route('login.store'), [
+        'email' => $user->email,
+        'password' => 'password',
+    ])->assertOk();
+
+    assertAuthenticatedAs($user);
+});
+
+it('authenticates a JSON login and records the user as actor and target', function (): void {
+    AuditLog::fake();
+    $user = User::factory()->createOne();
+
+    postJson(route('login.store'), [
+        'email' => $user->email,
+        'password' => 'password',
+    ])->assertOk()->assertExactJson(['two_factor' => false]);
+
+    assertAuthenticatedAs($user);
+    AuditLog::assertRecorded(
+        fn (AuditLogData $log): bool => $log->event === AuditLogEvent::AuthLogin->value
+            && $log->actor->id === (string) $user->id
+            && $log->targets[0]->id === (string) $user->id
+            && $log->tenantId === '',
+    );
+});
+
+it('logs out the authenticated user and records the logout', function (): void {
+    AuditLog::fake();
+    $user = login();
+
+    postJson(route('logout'))->assertNoContent();
+
+    assertGuest();
+    AuditLog::assertRecorded(
+        fn (AuditLogData $log): bool => $log->event === AuditLogEvent::AuthLogout->value
+            && $log->actor->id === (string) $user->id
+            && $log->targets[0]->id === (string) $user->id
+            && $log->tenantId === '',
+    );
+});
diff --git a/tests/Feature/Http/EmailVerificationTest.php b/tests/Feature/Http/EmailVerificationTest.php
new file mode 100644
