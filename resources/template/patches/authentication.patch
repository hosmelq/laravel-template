diff --git a/tests/Integration/Actions/FortifyPasswordTest.php b/tests/Integration/Actions/FortifyPasswordTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Integration/Actions/FortifyPasswordTest.php
@@ -0,0 +1,54 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Actions\Fortify\ResetUserPassword;
+use App\Actions\Fortify\UpdateUserPassword;
+use App\Models\User;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Validation\ValidationException;
+
+it('resets a password and stores its hash', function (): void {
+    $user = User::factory()->createOne(['password' => 'old-password']);
+
+    resolve(ResetUserPassword::class)->reset($user, [
+        'password' => 'new-password',
+        'password_confirmation' => 'new-password',
+    ]);
+
+    expect(Hash::check('new-password', $user->refresh()->password))->toBeTrue()
+        ->and(Hash::check('old-password', $user->password))->toBeFalse();
+});
+
+it('keeps the password when reset confirmation is invalid', function (): void {
+    $user = User::factory()->createOne(['password' => 'old-password']);
+
+    expect(fn () => resolve(ResetUserPassword::class)->reset($user, [
+        'password' => 'new-password',
+        'password_confirmation' => 'different-password',
+    ]))->toThrow(ValidationException::class)
+        ->and(Hash::check('old-password', $user->refresh()->password))->toBeTrue();
+});
+
+it('updates a password after validating the current password', function (): void {
+    $user = login(User::factory()->createOne(['password' => 'old-password']));
+
+    resolve(UpdateUserPassword::class)->update($user, [
+        'current_password' => 'old-password',
+        'password' => 'new-password',
+        'password_confirmation' => 'new-password',
+    ]);
+
+    expect(Hash::check('new-password', $user->refresh()->password))->toBeTrue();
+});
+
+it('rejects a password update with incorrect current credentials', function (): void {
+    $user = login(User::factory()->createOne(['password' => 'old-password']));
+
+    expect(fn () => resolve(UpdateUserPassword::class)->update($user, [
+        'current_password' => 'wrong-password',
+        'password' => 'new-password',
+        'password_confirmation' => 'new-password',
+    ]))->toThrow(ValidationException::class)
+        ->and(Hash::check('old-password', $user->refresh()->password))->toBeTrue();
+});
