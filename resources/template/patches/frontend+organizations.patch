+import {Button, Card, Link} from '@heroui/react'
+import {Head} from '@inertiajs/react'
+
+import {store} from '#/actions/App/Http/Controllers/InvitationController'
+import {Form} from '#/components/Form'
+
+interface ShowProps {
+  invitation: {
+    accepted: boolean
+    email: string
+    expired: boolean
+    invitedBy: string
+    organizationName: string
+    roleLabel: string
+  }
+  loginUrl: null | string
+  signedInEmail: null | string
+  token: string
+}
+
+export default function Show({invitation, loginUrl, signedInEmail, token}: ShowProps) {
+  return (
+    <>
+      <Head title="Organization invitation" />
+      <div className="m-auto w-full max-w-md p-4">
+        <Card>
+          <Card.Header>
+            <Card.Title>Join {invitation.organizationName}</Card.Title>
+          </Card.Header>
+          <Card.Content className="flex flex-col gap-4">
+            <p>
+              {invitation.invitedBy} invited you to join as {invitation.roleLabel}.
+            </p>
+            {invitation.accepted ? (
+              <p>This invitation has already been accepted.</p>
+            ) : invitation.expired ? (
+              <p>This invitation has expired. Ask for a new invitation.</p>
+            ) : signedInEmail === null ? (
+              <>
+                <p>Sign in with {invitation.email} to accept this invitation.</p>
+                {loginUrl && <Link href={loginUrl}>Sign in</Link>}
+              </>
+            ) : signedInEmail !== invitation.email ? (
+              <p>
+                You are signed in as {signedInEmail}. Sign in with {invitation.email} to accept this
+                invitation.
+              </p>
+            ) : (
+              <Form action={store(token)}>
+                {({processing}) => (
+                  <Button isPending={processing} type="submit">
+                    Accept invitation
+                  </Button>
+                )}
+              </Form>
+            )}
+          </Card.Content>
+        </Card>
+      </div>
+    </>
+  )
+}
