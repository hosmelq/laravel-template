+import {faGear} from '@fortawesome/pro-regular-svg-icons'
+import {FontAwesomeIcon} from '@fortawesome/react-fontawesome'
+import {AppLayout, Navbar, Sidebar} from '@heroui-pro/react'
+import {Avatar, Button, Description, Dropdown, Label, Typography} from '@heroui/react'
+import {usePage} from '@inertiajs/react'
+import type {ReactNode} from 'react'
+
+import {show} from '#/actions/App/Http/Controllers/OrganizationController'
+
+interface OrganizationProps {
+  children: ReactNode
+}
+
+function OrganizationSidebar() {
+  const {props, url} = usePage()
+  const {organization, permissions, user} = props.auth
+
+  if (!organization || !user) {
+    return null
+  }
+
+  const canViewSettings = permissions.includes('settings.view')
+  const settingsUrl = show.url(organization.slug)
+  const content = (
+    <>
+      <Sidebar.Header>
+        <div className="flex items-center gap-3">
+          <Avatar color="accent" size="sm">
+            <Avatar.Fallback>{organization.name.charAt(0).toUpperCase()}</Avatar.Fallback>
+          </Avatar>
+          <Typography data-sidebar="label" truncate type="body-sm" weight="semibold">
+            {organization.name}
+          </Typography>
+        </div>
+      </Sidebar.Header>
+      <Sidebar.Content>
+        {canViewSettings && (
+          <Sidebar.Group>
+            <Sidebar.Menu aria-label="Organization">
+              <Sidebar.MenuItem
+                href={settingsUrl}
+                id="settings"
+                isCurrent={url.split('?')[0] === settingsUrl}
+                textValue="Settings"
+              >
+                <Sidebar.MenuIcon>
+                  <FontAwesomeIcon icon={faGear} />
+                </Sidebar.MenuIcon>
+                <Sidebar.MenuLabel>Settings</Sidebar.MenuLabel>
+              </Sidebar.MenuItem>
+            </Sidebar.Menu>
+          </Sidebar.Group>
+        )}
+      </Sidebar.Content>
+      <Sidebar.Footer>
+        <Dropdown>
+          <Button
+            fullWidth
+            aria-label={`Account menu for ${user.name}`}
+            className="justify-start"
+            variant="ghost"
+          >
+            <Avatar size="sm">
+              <Avatar.Image alt={user.name} src={user.avatar_url} />
+              <Avatar.Fallback>{user.name.charAt(0).toUpperCase()}</Avatar.Fallback>
+            </Avatar>
+            <div className="min-w-0 text-left" data-sidebar="label">
+              <Typography truncate type="body-sm" weight="medium">
+                {user.name}
+              </Typography>
+              <Typography color="muted" truncate type="body-xs">
+                {user.email}
+              </Typography>
+            </div>
+          </Button>
+          <Dropdown.Popover placement="top start">
+            <Dropdown.Menu aria-label="Account">
+              <Dropdown.Section>
+                <Dropdown.Item id="account" isDisabled textValue={user.email}>
+                  <Label>{user.name}</Label>
+                  <Description>{user.email}</Description>
+                </Dropdown.Item>
+                {canViewSettings && (
+                  <Dropdown.Item href={settingsUrl} id="settings" textValue="Settings">
+                    <FontAwesomeIcon icon={faGear} />
+                    <Label>Settings</Label>
+                  </Dropdown.Item>
+                )}
+              </Dropdown.Section>
+            </Dropdown.Menu>
+          </Dropdown.Popover>
+        </Dropdown>
+      </Sidebar.Footer>
+    </>
+  )
+
+  return (
+    <>
+      <Sidebar>
+        {content}
+        <Sidebar.Rail />
+      </Sidebar>
+      <Sidebar.Mobile>{content}</Sidebar.Mobile>
+    </>
+  )
+}
+
+export function Organization({children}: OrganizationProps) {
+  const {organization, user} = usePage().props.auth
+
+  if (!organization || !user) {
+    return children
+  }
+
+  return (
+    <AppLayout
+      navbar={
+        <Navbar maxWidth="full">
+          <Navbar.Header>
+            <AppLayout.MenuToggle />
+            <Sidebar.Trigger />
+            <Typography type="body-sm" weight="semibold">
+              {organization.name}
+            </Typography>
+            <Navbar.Spacer />
+          </Navbar.Header>
+        </Navbar>
+      }
+      sidebar={<OrganizationSidebar />}
+    >
+      {children}
+    </AppLayout>
+  )
+}
