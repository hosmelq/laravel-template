@@ -0,0 +1,63 @@
+import {Card, FieldError, Input, Label, TextField} from '@heroui/react'
+import {Head, usePage} from '@inertiajs/react'
+
+import {update} from '#/actions/App/Http/Controllers/OrganizationController'
+import {Form} from '#/components/Form'
+import {Body, Header, HeaderContent, Main, Page, Title} from '#/components/Layout'
+import {UnsavedChangesBar} from '#/components/UnsavedChangesBar'
+import type {OrganizationResource} from '#/types/laravel'
+
+interface SettingsProps {
+  organization: OrganizationResource
+}
+
+export default function Settings({organization}: SettingsProps) {
+  const canUpdate = usePage().props.auth.permissions.includes('settings.organization')
+
+  return (
+    <>
+      <Head title="Organization settings" />
+      <Page>
+        <Header>
+          <HeaderContent>
+            <Title>Organization settings</Title>
+          </HeaderContent>
+        </Header>
+        <Body>
+          <Main>
+            <Form action={update(organization.slug)} setDefaultsOnSuccess>
+              {({isDirty, processing, resetAndClearErrors}) => (
+                <>
+                  <Card>
+                    <Card.Header>
+                      <Card.Title>General</Card.Title>
+                    </Card.Header>
+                    <Card.Content>
+                      <TextField
+                        defaultValue={organization.name}
+                        isReadOnly={!canUpdate}
+                        isRequired
+                        name="name"
+                      >
+                        <Label>Name</Label>
+                        <Input autoComplete="organization" maxLength={255} />
+                        <FieldError />
+                      </TextField>
+                    </Card.Content>
+                  </Card>
+                  {canUpdate && (
+                    <UnsavedChangesBar
+                      isDirty={isDirty}
+                      isPending={processing}
+                      onDiscard={resetAndClearErrors}
+                    />
+                  )}
+                </>
+              )}
+            </Form>
+          </Main>
+        </Body>
+      </Page>
+    </>
+  )
+}
