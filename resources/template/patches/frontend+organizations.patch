+<?php
+
+declare(strict_types=1);
+
+namespace App\Http\Controllers;
+
+use App\Actions\Invitations\AcceptInvitation;
+use App\Enums\MembershipPermission;
+use App\Models\Invitation;
+use App\Models\User;
+use Illuminate\Container\Attributes\CurrentUser;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Lang;
+use Illuminate\Support\Facades\Redirect;
+use Illuminate\Support\Facades\Route;
+use Inertia\Inertia;
+use Inertia\Response;
+
+class InvitationController
+{
+    public function show(string $token, #[CurrentUser] null|User $user): Response
+    {
+        $invitation = Invitation::query()
+            ->with(['invitedByUser', 'organization'])
+            ->where('token', hash('sha256', $token))
+            ->firstOrFail();
+
+        if (
+            ! $user instanceof User
+            && $invitation->accepted_at === null
+            && ! $invitation->isExpired()
+        ) {
+            Redirect::setIntendedUrl(route('invitations.show', ['token' => $token]));
+        }
+
+        return Inertia::render('invitations/Show', [
+            'invitation' => [
+                'accepted' => $invitation->accepted_at !== null,
+                'email' => $invitation->email,
+                'expired' => $invitation->isExpired(),
+                'invitedBy' => $invitation->invitedByUser->name->full(),
+                'organizationName' => $invitation->organization->name,
+                'roleLabel' => Lang::string($invitation->role->translationKey()),
+            ],
+            'loginUrl' => Route::has('login') ? route('login') : null,
+            'signedInEmail' => $user?->email,
+            'token' => $token,
+        ]);
+    }
+
+    public function store(
+        string $token,
+        #[CurrentUser] User $user,
+        AcceptInvitation $acceptInvitation,
+    ): RedirectResponse {
+        $invitation = DB::transaction(
+            function () use ($acceptInvitation, $token, $user): Invitation {
+                $invitation = Invitation::query()
+                    ->where('token', hash('sha256', $token))
+                    ->lockForUpdate()
+                    ->firstOrFail();
+
+                abort_if($invitation->accepted_at !== null || $invitation->isExpired(), 410);
+                abort_unless($user->email === $invitation->email, 403);
+
+                $acceptInvitation->handle($user, $invitation);
+
+                return $invitation;
+            },
+        );
+
+        return $user->can(MembershipPermission::SettingsView)
+            ? to_route('organizations.settings.general', [
+                'organization' => $invitation->organization,
+            ])
+            : to_route('home');
+    }
+}
