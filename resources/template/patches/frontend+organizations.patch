diff --git a/tests/Feature/Http/Controllers/OrganizationControllerTest.php b/tests/Feature/Http/Controllers/OrganizationControllerTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Feature/Http/Controllers/OrganizationControllerTest.php
@@ -0,0 +1,346 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\get;
+use function Pest\Laravel\getJson;
+use function Pest\Laravel\mock;
+use function Pest\Laravel\patch;
+use function Pest\Laravel\patchJson;
+use function Pest\Laravel\post;
+use function Pest\Laravel\postJson;
+
+use App\Actions\Organizations\CreateOrganization;
+use App\Actions\Organizations\Inputs\CreateOrganizationInput;
+use App\Actions\Organizations\Inputs\UpdateOrganizationInput;
+use App\Actions\Organizations\UpdateOrganization;
+use App\Enums\Permission;
+use App\Models\Organization;
+use App\Models\User;
+use Illuminate\Support\Str;
+use Inertia\Testing\AssertableInertia;
+
+describe('show', function (): void {
+    it('requires authentication', function (): void {
+        $organization = Organization::factory()->createOne();
+
+        $response = getJson(route('organizations.settings.general', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertUnauthorized();
+    });
+
+    it('prevents viewing from an unrelated organization', function (): void {
+        $unrelatedOrganization = Organization::factory()->createOne();
+
+        login(organization: Organization::factory()->createOne());
+
+        $response = get(route('organizations.settings.general', [
+            'organization' => $unrelatedOrganization,
+        ]));
+
+        $response->assertForbidden();
+    });
+
+    it('prevents viewing without permission', function (): void {
+        $organization = Organization::factory()->createOne();
+
+        login(organization: $organization);
+
+        $response = get(route('organizations.settings.general', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertForbidden();
+    });
+
+    it('prevents viewing with the settings update permission', function (): void {
+        $organization = Organization::factory()->createOne();
+
+        loginWithPermission(Permission::OrganizationsUpdateSettings, $organization);
+
+        $response = get(route('organizations.settings.general', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertForbidden();
+    });
+
+    it('prevents viewing when permission assignment remains without membership', function (): void {
+        $organization = Organization::factory()->createOne();
+        $user = loginWithPermission(Permission::OrganizationsView, $organization);
+
+        $user->organizations()->detach($organization);
+
+        $response = get(route('organizations.settings.general', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertForbidden();
+    });
+
+    it('does not use organization view permission from another organization', function (): void {
+        $organization = Organization::factory()->createOne();
+        $user = loginWithPermission(Permission::OrganizationsView, Organization::factory()->createOne());
+
+        $user->organizations()->syncWithoutDetaching($organization);
+
+        $response = get(route('organizations.settings.general', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertForbidden();
+    });
+
+    it('prevents an owner without membership from viewing organization settings', function (): void {
+        $organization = Organization::factory()->createOne();
+
+        login($organization->owner);
+
+        $response = get(route('organizations.settings.general', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertForbidden();
+    });
+
+    it('allows a member owner to view organization settings', function (): void {
+        $organization = Organization::factory()->createOne();
+        $organization->users()->attach($organization->owner);
+
+        login($organization->owner);
+
+        $response = get(route('organizations.settings.general', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertOk();
+    });
+
+    it('uses the route organization instead of the current organization for permission context', function (): void {
+        $organization = Organization::factory()->createOne();
+        $user = User::factory()->withOrganization(Organization::factory()->createOne())->createOne();
+
+        loginWithPermission(Permission::OrganizationsView, $organization, $user);
+
+        $response = get(route('organizations.settings.general', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertOk()
+            ->assertInertia(function (AssertableInertia $page) use ($organization): void {
+                $page->where('organization.id', $organization->sqid);
+            });
+    });
+
+    it('shows the organization settings page', function (): void {
+        $organization = Organization::factory()->createOne();
+
+        loginWithPermission(Permission::OrganizationsView, $organization);
+
+        $response = get(route('organizations.settings.general', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertOk()
+            ->assertInertia(function (AssertableInertia $page) use ($organization): void {
+                $page->component('organization/Settings')
+                    ->where('organization.id', $organization->sqid)
+                    ->where('organization.name', $organization->name);
+            });
+    });
+});
+
+describe('store', function (): void {
+    it('requires authentication', function (): void {
+        $response = postJson(route('organizations.store'));
+
+        $response->assertUnauthorized();
+    });
+
+    it('validates fields', function (array $data, array $expected): void {
+        login();
+
+        $response = post(route('organizations.store'), $data);
+
+        $response->assertRedirectBackWithErrors($expected);
+    })->with([
+        'max:255 (string)' => [
+            'data' => [
+                'name' => Str::repeat('a', 256),
+            ],
+            'expected' => [
+                'name' => 'The name field must not be greater than 255 characters.',
+            ],
+        ],
+        'required' => [
+            'data' => [],
+            'expected' => [
+                'name' => 'The name field is required.',
+            ],
+        ],
+    ]);
+
+    it('creates an organization', function (): void {
+        $user = login();
+        $organization = Organization::factory()->createOne();
+
+        mock(CreateOrganization::class)
+            ->shouldReceive('handle')
+            ->once()
+            ->withArgs(
+                fn (User $actualUser, CreateOrganizationInput $input): bool => $actualUser->is($user)
+                    && $input->name === 'My Organization',
+            )
+            ->andReturn($organization);
+
+        $response = post(route('organizations.store'), [
+            'name' => 'My Organization',
+        ]);
+
+        $response->assertRedirectToRoute('organizations.settings.general', [
+            'organization' => $organization,
+        ])
+            ->assertToast('Organization created');
+    });
+});
+
+describe('update', function (): void {
+    it('requires authentication', function (): void {
+        $organization = Organization::factory()->createOne();
+
+        $response = patchJson(route('organizations.update', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertUnauthorized();
+    });
+
+    it('prevents updating from an unrelated organization', function (): void {
+        $unrelatedOrganization = Organization::factory()->createOne();
+
+        login(organization: Organization::factory()->createOne());
+
+        $response = patch(route('organizations.update', [
+            'organization' => $unrelatedOrganization,
+        ]));
+
+        $response->assertForbidden();
+    });
+
+    it('prevents updating without permission', function (): void {
+        $organization = Organization::factory()->createOne();
+
+        login(organization: $organization);
+
+        $response = patch(route('organizations.update', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertForbidden();
+    });
+
+    it('prevents updating with the organization view permission', function (): void {
+        $organization = Organization::factory()->createOne();
+
+        loginWithPermission(Permission::OrganizationsView, $organization);
+
+        $response = patch(route('organizations.update', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertForbidden();
+    });
+
+    it('does not use settings update permission from another organization', function (): void {
+        $organization = Organization::factory()->createOne();
+        $user = loginWithPermission(Permission::OrganizationsUpdateSettings, Organization::factory()->createOne());
+
+        $user->organizations()->syncWithoutDetaching($organization);
+
+        $response = patch(route('organizations.update', [
+            'organization' => $organization,
+        ]));
+
+        $response->assertForbidden();
+    });
+
+    it('validates fields', function (array $data, array $expected): void {
+        $organization = Organization::factory()->createOne();
+
+        loginWithPermission(Permission::OrganizationsUpdateSettings, $organization);
+
+        $response = patch(route('organizations.update', [
+            'organization' => $organization,
+        ]), $data);
+
+        $response->assertRedirectBackWithErrors($expected);
+    })->with([
+        'max:255 (string)' => [
+            'data' => [
+                'name' => Str::repeat('a', 256),
+            ],
+            'expected' => [
+                'name' => 'The name field must not be greater than 255 characters.',
+            ],
+        ],
+        'sometimes (required)' => [
+            'data' => [
+                'name' => '',
+            ],
+            'expected' => [
+                'name' => 'The name field is required.',
+            ],
+        ],
+    ]);
+
+    it('allows a member owner to update organization settings', function (): void {
+        $organization = Organization::factory()->createOne();
+        $organization->users()->attach($organization->owner);
+
+        mock(UpdateOrganization::class)
+            ->shouldReceive('handle')
+            ->once()
+            ->withArgs(
+                fn (Organization $actualOrganization, UpdateOrganizationInput $input): bool => $actualOrganization->is($organization)
+                    && $input->name === 'Updated Organization',
+            );
+
+        login($organization->owner);
+
+        $response = patch(route('organizations.update', [
+            'organization' => $organization,
+        ]), [
+            'name' => 'Updated Organization',
+        ]);
+
+        $response->assertRedirectBack()
+            ->assertToast('Settings updated');
+    });
+
+    it('updates organization settings', function (): void {
+        $organization = Organization::factory()->createOne([
+            'name' => 'My Organization',
+        ]);
+
+        mock(UpdateOrganization::class)
+            ->shouldReceive('handle')
+            ->once()
+            ->withArgs(
+                fn (Organization $actualOrganization, UpdateOrganizationInput $input): bool => $actualOrganization->is($organization)
+                    && $input->name === 'Updated Organization',
+            );
+
+        loginWithPermission(Permission::OrganizationsUpdateSettings, $organization);
+
+        $response = patch(route('organizations.update', [
+            'organization' => $organization,
+        ]), [
+            'name' => 'Updated Organization',
+        ]);
+
+        $response->assertRedirectBack()
+            ->assertToast('Settings updated');
+    });
+});
