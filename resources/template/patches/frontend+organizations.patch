@@ -0,0 +1,34 @@
+import {Button, FieldError, Input, Label, TextField} from '@heroui/react'
+import {Head} from '@inertiajs/react'
+
+import {update} from '#/actions/App/Http/Controllers/OrganizationController'
+import {Form} from '#/components/Form'
+import type {OrganizationResource} from '#/types/laravel'
+
+interface SettingsProps {
+  organization: OrganizationResource
+}
+
+export default function Settings({organization}: SettingsProps) {
+  return (
+    <>
+      <Head title="Organization settings" />
+      <div className="mx-auto max-w-sm">
+        <Form action={update(organization.slug)} className="flex flex-col gap-y-4">
+          {({processing}) => (
+            <>
+              <TextField defaultValue={organization.name} isRequired name="name">
+                <Label>Name</Label>
+                <Input autoComplete="organization" />
+                <FieldError />
+              </TextField>
+              <Button isPending={processing} type="submit">
+                Save
+              </Button>
+            </>
+          )}
+        </Form>
+      </div>
+    </>
+  )
+}
