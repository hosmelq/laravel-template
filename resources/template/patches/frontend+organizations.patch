diff --git a/tests/Feature/Http/Controllers/InvitationControllerTest.php b/tests/Feature/Http/Controllers/InvitationControllerTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Feature/Http/Controllers/InvitationControllerTest.php
@@ -0,0 +1,170 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertDatabaseCount;
+use function Pest\Laravel\assertDatabaseMissing;
+use function Pest\Laravel\get;
+use function Pest\Laravel\post;
+use function Pest\Laravel\postJson;
+
+use App\Enums\MembershipRole;
+use App\Models\Invitation;
+use App\Models\Organization;
+use Illuminate\Support\Facades\Route;
+use Inertia\Testing\AssertableInertia;
+
+describe('show', function (): void {
+    it('rejects an unknown token', function (): void {
+        get(route('invitations.show', 'missing'))->assertNotFound();
+    });
+
+    it('shows a guest the invitation without requiring authentication routes', function (): void {
+        $invitation = Invitation::factory()->withToken('invitation-token')->createOne();
+
+        get(route('invitations.show', 'invitation-token'))
+            ->assertOk()
+            ->assertSessionHas('url.intended', route('invitations.show', 'invitation-token'))
+            ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+                ->component('invitations/Show')
+                ->where('invitation.accepted', false)
+                ->where('invitation.expired', false)
+                ->where('invitation.invitedBy', $invitation->invitedByUser->name->full())
+                ->where('invitation.organizationName', $invitation->organization->name)
+                ->where('invitation.roleLabel', 'Viewer')
+                ->where('loginUrl', null)
+                ->where('signedInEmail', null));
+    });
+
+    it('provides a sign-in link when the optional route exists', function (): void {
+        Invitation::factory()->withToken('invitation-token')->createOne();
+        Route::getRoutes()->add(Route::get('sign-in', fn (): string => 'Sign in')->name('login'));
+
+        get(route('invitations.show', 'invitation-token'))
+            ->assertOk()
+            ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+                ->where('loginUrl', route('login')));
+    });
+
+    it('shows expired and accepted states', function (string $state): void {
+        Invitation::factory()->withToken('invitation-token')->{$state}()->createOne();
+
+        get(route('invitations.show', 'invitation-token'))
+            ->assertOk()
+            ->assertSessionMissing('url.intended')
+            ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+                ->where('invitation.'.$state, true));
+    })->with(['accepted', 'expired']);
+
+    it('shows the signed-in email without accepting an invitation for another account', function (): void {
+        $user = login();
+        $invitation = Invitation::factory()->withToken('invitation-token')->createOne();
+
+        get(route('invitations.show', 'invitation-token'))
+            ->assertOk()
+            ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+                ->where('signedInEmail', $user->email));
+
+        expect($invitation->fresh()->accepted_at)->toBeNull();
+    });
+
+    it('does not accept the matching account through a GET request', function (): void {
+        $user = login();
+        $invitation = Invitation::factory()
+            ->withToken('invitation-token')
+            ->createOne(['email' => $user->email]);
+
+        get(route('invitations.show', 'invitation-token'))->assertOk();
+
+        expect($invitation->fresh()->accepted_at)->toBeNull();
+        assertDatabaseMissing('organization_user', [
+            'organization_id' => $invitation->organization_id,
+            'user_id' => $user->id,
+        ]);
+    });
+});
+
+describe('accept', function (): void {
+    it('requires authentication', function (): void {
+        postJson(route('invitations.accept', 'invitation-token'))->assertUnauthorized();
+    });
+
+    it('rejects an unknown token', function (): void {
+        login();
+
+        post(route('invitations.accept', 'missing'))->assertNotFound();
+    });
+
+    it('rejects expired or accepted invitations', function (string $state): void {
+        $user = login();
+        $invitation = Invitation::factory()
+            ->withToken('invitation-token')
+            ->{$state}()
+            ->createOne(['email' => $user->email]);
+
+        post(route('invitations.accept', 'invitation-token'))->assertGone();
+
+        assertDatabaseMissing('organization_user', [
+            'organization_id' => $invitation->organization_id,
+            'user_id' => $user->id,
+        ]);
+        expect($user->fresh()->current_organization_id)->toBeNull();
+    })->with(['accepted', 'expired']);
+
+    it('rejects a different signed-in email', function (): void {
+        $user = login();
+        $invitation = Invitation::factory()->withToken('invitation-token')->createOne();
+
+        post(route('invitations.accept', 'invitation-token'))->assertForbidden();
+
+        expect($invitation->fresh()->accepted_at)->toBeNull();
+        assertDatabaseMissing('organization_user', [
+            'organization_id' => $invitation->organization_id,
+            'user_id' => $user->id,
+        ]);
+    });
+
+    it('accepts the invitation and switches the active organization', function (
+        MembershipRole $role,
+        string $route,
+    ): void {
+        $originalOrganization = Organization::factory()->createOne();
+        $user = login(organization: $originalOrganization);
+        $user->switchOrganization($originalOrganization);
+        $user->assignRole(MembershipRole::Viewer);
+        $user->load(['organizations', 'permissions', 'roles']);
+
+        $invitation = Invitation::factory()
+            ->withToken('invitation-token')
+            ->createOne(['email' => $user->email, 'role' => $role]);
+
+        post(route('invitations.accept', 'invitation-token'))
+            ->assertRedirectToRoute(
+                $route,
+                $route === 'home' ? [] : ['organization' => $invitation->organization],
+            );
+
+        $user->refresh();
+        expect($user)->current_organization_id->toBe($invitation->organization_id)
+            ->and($invitation->fresh()->accepted_at)->toEqual(now());
+        $user->switchOrganization($invitation->organization);
+        expect($user->hasRole($role))->toBeTrue();
+        $user->switchOrganization($originalOrganization);
+        expect($user->hasRole(MembershipRole::Viewer))->toBeTrue();
+    })->with([
+        'admin' => [MembershipRole::Admin, 'organizations.settings.general'],
+        'owner' => [MembershipRole::Owner, 'organizations.settings.general'],
+        'viewer' => [MembershipRole::Viewer, 'home'],
+    ]);
+
+    it('cannot replay a successful acceptance', function (): void {
+        $user = login();
+        Invitation::factory()->withToken('invitation-token')->createOne(['email' => $user->email]);
+
+        post(route('invitations.accept', 'invitation-token'))->assertRedirectToRoute('home');
+        post(route('invitations.accept', 'invitation-token'))->assertGone();
+
+        assertDatabaseCount('organization_user', 1);
+        assertDatabaseCount('model_has_roles', 1);
+    });
+});
diff --git a/tests/Feature/Http/Controllers/OrganizationControllerTest.php b/tests/Feature/Http/Controllers/OrganizationControllerTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Feature/Http/Controllers/OrganizationControllerTest.php
@@ -0,0 +1,248 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\get;
+use function Pest\Laravel\getJson;
+use function Pest\Laravel\patch;
+use function Pest\Laravel\patchJson;
+use function Pest\Laravel\post;
+use function Pest\Laravel\postJson;
+
+use App\Enums\MembershipPermission;
+use App\Enums\MembershipRole;
+use App\Models\Organization;
+use Illuminate\Support\Str;
+use Inertia\Testing\AssertableInertia;
+
+describe('create', function (): void {
+    it('requires authentication', function (): void {
+        getJson(route('organizations.create'))->assertUnauthorized();
+    });
+
+    it('shows the organization creation page without a current organization', function (): void {
+        login();
+
+        get(route('organizations.create'))
+            ->assertOk()
+            ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+                ->component('organization/Create')
+                ->where('auth.organization', null)
+                ->where('auth.permissions', []));
+    });
+});
+
+describe('show', function (): void {
+    it('requires authentication', function (): void {
+        $organization = Organization::factory()->createOne();
+
+        getJson(route('organizations.settings.general', $organization))->assertUnauthorized();
+    });
+
+    it('prevents viewing from an unrelated organization', function (): void {
+        $organization = Organization::factory()->createOne();
+        login(organization: Organization::factory()->createOne());
+
+        get(route('organizations.settings.general', $organization))->assertForbidden();
+    });
+
+    it('prevents viewing without permission', function (): void {
+        $organization = Organization::factory()->createOne();
+        $user = login(organization: $organization);
+        $user->switchOrganization($organization);
+        $user->assignRole(MembershipRole::Viewer);
+
+        get(route('organizations.settings.general', $organization))->assertForbidden();
+    });
+
+    it('does not allow the update permission to grant settings access', function (): void {
+        $organization = Organization::factory()->createOne();
+        $user = login(organization: $organization);
+        $user->switchOrganization($organization);
+        $user->givePermissionTo(MembershipPermission::SettingsOrganization);
+
+        get(route('organizations.settings.general', $organization))->assertForbidden();
+    });
+
+    it('does not use a role from another organization', function (): void {
+        $organization = Organization::factory()->createOne();
+        $otherOrganization = Organization::factory()->createOne();
+        $user = login(organization: $otherOrganization);
+        $user->switchOrganization($otherOrganization);
+        $user->assignRole(MembershipRole::Admin);
+        $user->organizations()->attach($organization);
+        $user->unsetRelation('organizations');
+        $user->switchOrganization($organization);
+        $user->assignRole(MembershipRole::Viewer);
+
+        get(route('organizations.settings.general', $organization))->assertForbidden();
+    });
+
+    it('rejects an inactive organization even when its membership has permission', function (): void {
+        $organization = Organization::factory()->createOne();
+        $user = login(organization: $organization);
+        $user->switchOrganization($organization);
+        $user->assignRole(MembershipRole::Admin);
+
+        $otherOrganization = Organization::factory()->createOne();
+        $user->organizations()->attach($otherOrganization);
+        $user->unsetRelation('organizations');
+        $user->switchOrganization($otherOrganization);
+
+        get(route('organizations.settings.general', $organization))->assertForbidden();
+    });
+
+    it('shows settings for authorized roles', function (MembershipRole $role): void {
+        $organization = Organization::factory()->createOne();
+        $user = login(organization: $organization);
+        $user->switchOrganization($organization);
+        $user->assignRole($role);
+
+        get(route('organizations.settings.general', $organization))
+            ->assertOk()
+            ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+                ->component('organization/Settings')
+                ->where('organization.id', $organization->sqid)
+                ->where('organization.name', $organization->name)
+                ->where('organization.slug', $organization->slug)
+                ->where('auth.organization.id', $organization->sqid)
+                ->where('auth.permissions', MembershipPermission::values()));
+    })->with([
+        'admin' => MembershipRole::Admin,
+        'owner' => MembershipRole::Owner,
+    ]);
+
+    it('allows settings viewing without update permission', function (): void {
+        $organization = Organization::factory()->createOne();
+        $user = login(organization: $organization);
+        $user->switchOrganization($organization);
+        $user->givePermissionTo(MembershipPermission::SettingsView);
+
+        get(route('organizations.settings.general', $organization))
+            ->assertOk()
+            ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+                ->where('auth.permissions', [MembershipPermission::SettingsView->value]));
+    });
+});
+
+describe('store', function (): void {
+    it('requires authentication', function (): void {
+        postJson(route('organizations.store'))->assertUnauthorized();
+    });
+
+    it('validates fields', function (array $data): void {
+        login();
+
+        postJson(
+            route('organizations.store'),
+            $data,
+        )->assertUnprocessable()->assertJsonValidationErrors(
+            'name',
+        );
+    })->with([
+        'max:255' => [['name' => Str::repeat('a', 256)]],
+        'required' => [[]],
+        'string' => [['name' => ['Acme']]],
+    ]);
+
+    it('creates an organization and switches to it as owner', function (): void {
+        $user = login();
+        $response = post(route('organizations.store'), ['name' => 'Acme']);
+        $organization = Organization::query()->sole();
+        $user->refresh();
+        expect($user->current_organization_id)->toBe($organization->id);
+        $user->switchOrganization($organization);
+
+        $response->assertRedirectToRoute('organizations.settings.general', $organization)
+            ->assertToast('Organization created');
+
+        expect($organization)->name->toBe('Acme')->owner_id->toBe($user->id)
+            ->and($user)->current_organization_id->toBe($organization->id)
+            ->belongsToOrganization($organization)->toBeTrue()
+            ->hasRole(MembershipRole::Owner)->toBeTrue();
+    });
+});
+
+describe('update', function (): void {
+    it('requires authentication', function (): void {
+        $organization = Organization::factory()->createOne();
+
+        patchJson(route('organizations.update', $organization))->assertUnauthorized();
+    });
+
+    it('prevents updating from an unrelated organization', function (): void {
+        $organization = Organization::factory()->createOne();
+        login(organization: Organization::factory()->createOne());
+
+        patch(route('organizations.update', $organization), [
+            'name' => 'Changed',
+        ])->assertForbidden();
+
+        expect($organization->fresh()->name)->toBe($organization->name);
+    });
+
+    it('prevents updating without update permission', function (): void {
+        $organization = Organization::factory()->createOne();
+        $user = login(organization: $organization);
+        $user->switchOrganization($organization);
+        $user->assignRole(MembershipRole::Viewer);
+        $user->givePermissionTo(MembershipPermission::SettingsView);
+
+        patch(route('organizations.update', $organization), [
+            'name' => 'Changed',
+        ])->assertForbidden();
+
+        expect($organization->fresh()->name)->toBe($organization->name);
+    });
+
+    it('does not use update permission from another organization', function (): void {
+        $organization = Organization::factory()->createOne();
+        $otherOrganization = Organization::factory()->createOne();
+        $user = login(organization: $otherOrganization);
+        $user->switchOrganization($otherOrganization);
+        $user->assignRole(MembershipRole::Admin);
+        $user->organizations()->attach($organization);
+        $user->unsetRelation('organizations');
+        $user->switchOrganization($organization);
+
+        patch(route('organizations.update', $organization), [
+            'name' => 'Changed',
+        ])->assertForbidden();
+
+        expect($organization->fresh()->name)->toBe($organization->name);
+    });
+
+    it('validates fields', function (array $data): void {
+        $organization = Organization::factory()->createOne();
+        $user = login(organization: $organization);
+        $user->switchOrganization($organization);
+        $user->assignRole(MembershipRole::Admin);
+
+        patchJson(
+            route('organizations.update', $organization),
+            $data,
+        )->assertUnprocessable()->assertJsonValidationErrors(
+            'name',
+        );
+    })->with([
+        'max:255' => [['name' => Str::repeat('a', 256)]],
+        'required' => [['name' => '']],
+        'string' => [['name' => ['Acme']]],
+    ]);
+
+    it('updates organization settings for authorized roles', function (MembershipRole $role): void {
+        $organization = Organization::factory()->createOne();
+        $user = login(organization: $organization);
+        $user->switchOrganization($organization);
+        $user->assignRole($role);
+
+        patch(route('organizations.update', $organization), ['name' => 'Acme'])
+            ->assertRedirectBack()
+            ->assertToast('Settings updated');
+
+        expect($organization->fresh()->name)->toBe('Acme');
+    })->with([
+        'admin' => MembershipRole::Admin,
+        'owner' => MembershipRole::Owner,
+    ]);
+});
