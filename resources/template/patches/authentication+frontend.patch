+++ b/tests/Browser/Auth/PasswordResetTest.php
@@ -0,0 +1,63 @@
+<?php
+
+declare(strict_types=1);
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+it('opens password recovery from sign in', function (): void {
+    visit('/login')->click('Forgot your password?')->assertPathIs('/forgot-password')
+        ->assertSee('Enter your email to request a password reset link.')->assertNoJavascriptErrors();
+});
+
+it('shows the sent status after requesting a link', function (): void {
+    Notification::fake();
+    $user = User::factory()->createOne();
+
+    visit('/forgot-password')->type('Email', $user->email)->press('Send link')
+        ->assertSee('We have emailed your password reset link.')->assertNoJavascriptErrors();
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+it('shows errors for an unknown account while retaining the email', function (): void {
+    visit('/forgot-password')->type('Email', 'missing@example.com')->press('Send link')
+        ->assertSee("We can't find an account with that email.")
+        ->assertValue('Email', 'missing@example.com')->assertNoJavascriptErrors();
+});
+
+it('resets the password and returns to sign in', function (): void {
+    $user = User::factory()->createOne();
+    $token = Password::createToken($user);
+
+    visit('/reset-password/'.$token.'?email='.urlencode($user->email))
+        ->assertValue('Email', $user->email)->type('New password', 'new-password-123')
+        ->type('Confirm new password', 'new-password-123')->press('button[type="submit"]')
+        ->assertPathIs('/login')->assertSee('Your password has been reset.')->assertNoJavascriptErrors();
+
+    expect(Hash::check('new-password-123', $user->refresh()->password))->toBeTrue()
+        ->and(Password::tokenExists($user, $token))->toBeFalse();
+});
+
+it('shows confirmation errors for the new password', function (): void {
+    $user = User::factory()->createOne();
+    $token = Password::createToken($user);
+
+    visit('/reset-password/'.$token.'?email='.urlencode($user->email))
+        ->type('New password', 'new-password-123')->type('Confirm new password', 'other-password')
+        ->press('button[type="submit"]')->assertSee('The password field confirmation does not match.')
+        ->assertNoJavascriptErrors();
+});
+
+it('offers another link after an invalid reset token', function (): void {
+    $user = User::factory()->createOne();
+
+    visit('/reset-password/invalid-token?email='.urlencode($user->email))
+        ->type('New password', 'new-password-123')->type('Confirm new password', 'new-password-123')
+        ->press('button[type="submit"]')
+        ->assertSee('This password reset link is invalid or has expired. Request a new one.')
+        ->click('Request a new link')->assertPathIs('/forgot-password')->assertNoJavascriptErrors();
+});
