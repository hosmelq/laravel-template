@@ -0,0 +1,88 @@
+import {Alert, Button} from '@heroui/react'
+import {Head, setLayoutProps, usePage} from '@inertiajs/react'
+
+import {destroy} from '#/actions/Laravel/Fortify/Http/Controllers/AuthenticatedSessionController'
+import {store} from '#/actions/Laravel/Fortify/Http/Controllers/EmailVerificationNotificationController'
+import {Form} from '#/components/Form'
+import type {AuthLayoutProps} from '#/layouts/Auth'
+import type {EmailVerificationWarning} from '#/types/generated/enums'
+
+interface VerifyEmailProps {
+  email: string
+  status: null | string
+  warning: EmailVerificationWarning | null
+}
+
+const warnings: Record<EmailVerificationWarning, {description: string; title: string}> = {
+  expired: {
+    description: 'Request a new verification link to confirm your email address.',
+    title: 'This verification link has expired',
+  },
+  other_account: {
+    description: 'Sign out and open the link with the account it was sent to.',
+    title: 'This link belongs to another account',
+  },
+}
+
+export default function VerifyEmail({email, status, warning}: VerifyEmailProps) {
+  const {errors} = usePage().props
+  const message = warning ? warnings[warning] : null
+
+  setLayoutProps<AuthLayoutProps>({
+    heading: 'Verify your email',
+    lead: `Open the verification link in your inbox to confirm ${email}.`,
+    status: null,
+  })
+
+  return (
+    <>
+      <Head title="Verify your email" />
+      <div className="flex flex-col gap-4">
+        {message && (
+          <Alert status="warning">
+            <Alert.Indicator />
+            <Alert.Content>
+              <Alert.Title>{message.title}</Alert.Title>
+              <Alert.Description>{message.description}</Alert.Description>
+            </Alert.Content>
+          </Alert>
+        )}
+        {errors.verification ? (
+          <Alert status="danger">
+            <Alert.Indicator />
+            <Alert.Content>
+              <Alert.Title>{errors.verification}</Alert.Title>
+            </Alert.Content>
+          </Alert>
+        ) : status === 'verification-link-sent' ? (
+          <Alert status="success">
+            <Alert.Indicator />
+            <Alert.Content>
+              <Alert.Title>A new verification link has been sent to {email}.</Alert.Title>
+            </Alert.Content>
+          </Alert>
+        ) : null}
+        <Form action={store()}>
+          {({processing}) => (
+            <Button fullWidth isPending={processing} type="submit">
+              Resend link
+            </Button>
+          )}
+        </Form>
+        {!warning && (
+          <p className="text-sm text-muted">
+            Check your spam folder if the message has not arrived.
+          </p>
+        )}
+        <p className="text-sm text-muted">Signed in as {email}</p>
+        <Form action={destroy()}>
+          {({processing}) => (
+            <Button isPending={processing} type="submit" variant="ghost">
+              Sign out
+            </Button>
+          )}
+        </Form>
+      </div>
+    </>
+  )
+}
