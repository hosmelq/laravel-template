diff --git a/tests/Browser/Auth/VerifyEmailTest.php b/tests/Browser/Auth/VerifyEmailTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Browser/Auth/VerifyEmailTest.php
@@ -0,0 +1,62 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertGuest;
+use function Pest\Laravel\withSession;
+
+use App\Enums\EmailVerificationWarning;
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Facades\URL;
+
+it('shows the signed in email and resends verification', function (): void {
+    Notification::fake();
+    $user = login(User::factory()->unverified()->createOne(['email' => 'alex@example.com']));
+
+    visit('/email/verify')->assertSee('Verify your email')->assertSee('Signed in as alex@example.com')
+        ->press('Resend link')->assertSee('A new verification link has been sent to alex@example.com.')
+        ->assertNoJavascriptErrors();
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+it('shows resend limit errors and keeps the form usable', function (): void {
+    $limiter = RateLimiter::limiter('verification');
+    RateLimiter::shouldReceive('availableIn')->andReturn(60);
+    RateLimiter::shouldReceive('limiter')->with('verification')->andReturn($limiter);
+    RateLimiter::shouldReceive('tooManyAttempts')->andReturnTrue();
+    login(User::factory()->unverified()->createOne());
+
+    visit('/email/verify')->press('Resend link')->assertSee('Too many attempts. Try again in a minute.')
+        ->assertEnabled('Resend link')->assertNoJavascriptErrors();
+});
+
+it('shows verification warnings and lets the user sign out', function (EmailVerificationWarning $warning, string $message): void {
+    login(User::factory()->unverified()->createOne());
+    withSession(['verification_warning' => $warning->value]);
+
+    visit('/email/verify')->assertSee($message)->press('Sign out')->assertPathIs('/login')
+        ->assertSee('Enter your email and password to continue.')->assertNoJavascriptErrors();
+
+    assertGuest();
+})->with([
+    'expired' => [EmailVerificationWarning::Expired, 'This verification link has expired'],
+    'other account' => [EmailVerificationWarning::OtherAccount, 'This link belongs to another account'],
+]);
+
+it('verifies a signed link and continues home', function (): void {
+    $user = login(User::factory()->unverified()->createOne(['first_name' => 'Alex']));
+    $url = URL::temporarySignedRoute('verification.verify', now()->addHour(), [
+        'hash' => sha1($user->email),
+        'id' => $user->id,
+    ]);
+
+    visit($url)->assertPathIs('/email/verified')->assertSee('Email confirmed')
+        ->assertSee('Thank you, Alex. Your email address is verified.')
+        ->click('Continue')->assertPathIs('/')->assertNoJavascriptErrors();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeTrue();
+});
diff --git a/tests/Feature/Http/AuthenticationPagesTest.php b/tests/Feature/Http/AuthenticationPagesTest.php
