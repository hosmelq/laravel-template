+++ b/tests/Browser/Auth/LoginTest.php
@@ -0,0 +1,73 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\assertAuthenticatedAs;
+use function Pest\Laravel\withSession;
+
+use App\Models\User;
+use Illuminate\Support\Facades\RateLimiter;
+
+it('shows the generic sign in page', function (): void {
+    visit('/login')
+        ->assertTitle('Sign in - Template')
+        ->assertSee('Enter your email and password to continue.')
+        ->assertSee('Remember me')
+        ->assertNoJavascriptErrors();
+});
+
+it('shows credential errors and keeps the form usable', function (): void {
+    $user = User::factory()->createOne();
+
+    visit('/login')
+        ->type('Email', $user->email)
+        ->type('Password', 'incorrect-password')
+        ->press('button[type="submit"]')
+        ->assertSee('These credentials do not match our records.')
+        ->assertValue('Email', $user->email)
+        ->assertValue('Password', 'incorrect-password')
+        ->type('Password', 'another-password')
+        ->assertValue('Password', 'another-password')
+        ->assertNoJavascriptErrors();
+});
+
+it('shows required errors for empty fields', function (): void {
+    visit('/login')->press('button[type="submit"]')
+        ->assertSee('The email field is required.')
+        ->assertSee('The password field is required.')
+        ->assertNoJavascriptErrors();
+});
+
+it('shows the password reset status', function (): void {
+    withSession(['status' => 'Your password has been reset.']);
+
+    visit('/login')->assertSee('Your password has been reset.')->assertNoJavascriptErrors();
+});
+
+it('shows lockout errors and keeps the sign in button enabled', function (): void {
+    $user = User::factory()->createOne();
+    $limiter = RateLimiter::limiter('login');
+    RateLimiter::shouldReceive('availableIn')->andReturn(42);
+    RateLimiter::shouldReceive('limiter')->with('login')->andReturn($limiter);
+    RateLimiter::shouldReceive('tooManyAttempts')->andReturnTrue();
+
+    visit('/login')
+        ->type('Email', $user->email)
+        ->type('Password', 'incorrect-password')
+        ->press('button[type="submit"]')
