+++ b/resources/js/layouts/Auth.tsx
@@ -0,0 +1,61 @@
+import {Alert, Link} from '@heroui/react'
+import type {ReactNode} from 'react'
+
+export interface AuthLayoutProps {
+  accountLink?: {href: string; label: string}
+  accountText?: string
+  appName?: string
+  children?: ReactNode
+  heading?: string
+  lead?: string
+  logo?: ReactNode
+  secondaryLink?: {href: string; label: string}
+  status?: null | string
+}
+
+export function Auth({
+  accountLink,
+  accountText,
+  appName = 'Template',
+  children,
+  heading,
+  lead,
+  logo,
+  secondaryLink,
+  status,
+}: AuthLayoutProps) {
+  return (
+    <div className="flex min-h-svh flex-col bg-background px-6 py-8 text-foreground">
+      <header className="mx-auto w-full max-w-sm">
+        <Link className="text-lg font-semibold text-foreground" href="/">
+          {logo ?? appName}
+        </Link>
+      </header>
+      <main className="mx-auto flex w-full max-w-sm flex-1 flex-col justify-center gap-6 py-12">
+        <div className="space-y-2">
+          <h1 className="text-2xl font-semibold">{heading}</h1>
+          {lead && <p className="text-sm text-muted">{lead}</p>}
+        </div>
+        {status && (
+          <Alert status="success">
+            <Alert.Indicator />
+            <Alert.Content>
+              <Alert.Title>{status}</Alert.Title>
+            </Alert.Content>
+          </Alert>
+        )}
+        {children}
+        {accountLink && (
+          <p className="text-sm text-muted">
+            {accountText && <>{accountText} </>}
+            <Link href={accountLink.href}>{accountLink.label}</Link>
+          </p>
+        )}
+        {secondaryLink && <Link href={secondaryLink.href}>{secondaryLink.label}</Link>}
+      </main>
+      <footer className="mx-auto w-full max-w-sm text-sm text-muted">
+        <Link href="/">Back to home</Link>
+      </footer>
+    </div>
+  )
+}
