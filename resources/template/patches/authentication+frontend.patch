diff --git a/resources/js/pages/auth/Login.tsx b/resources/js/pages/auth/Login.tsx
new file mode 100644
--- /dev/null
+++ b/resources/js/pages/auth/Login.tsx
@@ -0,0 +1,30 @@
+import {Button, FieldError, Input, Label, TextField} from '@heroui/react'
+
+import {store} from '#/actions/Laravel/Fortify/Http/Controllers/AuthenticatedSessionController'
+import {Form} from '#/components/Form'
+
+export default function Login() {
+  return (
+    <div className="mx-auto max-w-sm">
+      <Form action={store()} className="flex flex-col gap-y-4">
+        {({processing}) => (
+          <>
+            <TextField isRequired name="email">
+              <Label>Email Address</Label>
+              <Input autoComplete="email" inputMode="email" type="email" />
+              <FieldError />
+            </TextField>
+            <TextField isRequired name="password">
+              <Label>Password</Label>
+              <Input autoComplete="current-password" type="password" />
+              <FieldError />
+            </TextField>
+            <Button isPending={processing} type="submit">
+              Sign In
+            </Button>
+          </>
+        )}
+      </Form>
+    </div>
+  )
+}
