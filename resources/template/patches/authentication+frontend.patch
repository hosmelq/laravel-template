+import {Button, Checkbox, FieldError, Input, Label, Link, TextField} from '@heroui/react'
+import {Head, setLayoutProps} from '@inertiajs/react'
+
+import {store} from '#/actions/Laravel/Fortify/Http/Controllers/AuthenticatedSessionController'
+import {create as forgotPassword} from '#/actions/Laravel/Fortify/Http/Controllers/PasswordResetLinkController'
+import {create as register} from '#/actions/Laravel/Fortify/Http/Controllers/RegisteredUserController'
+import {Form} from '#/components/Form'
+import type {AuthLayoutProps} from '#/layouts/Auth'
+
+import {PasswordField} from './_components/PasswordField'
+
+interface LoginProps {
+  canRegister: boolean
+  canResetPassword: boolean
+  status: null | string
+}
+
+export default function Login({canRegister, canResetPassword, status}: LoginProps) {
+  setLayoutProps<AuthLayoutProps>({
+    accountLink: canRegister ? {href: register.url(), label: 'Create account'} : undefined,
+    accountText: canRegister ? 'Need an account?' : undefined,
+    heading: 'Sign in',
+    lead: 'Enter your email and password to continue.',
+    status,
+  })
+
+  return (
+    <>
+      <Head title="Sign in" />
+      <Form action={store()} className="flex flex-col gap-4" noValidate>
+        {({processing}) => (
+          <>
+            <TextField fullWidth isRequired name="email">
+              <Label>Email</Label>
+              <Input autoComplete="email" inputMode="email" type="email" />
+              <FieldError />
+            </TextField>
+            <PasswordField autoComplete="current-password" label="Password" name="password" />
+            <div className="flex flex-wrap items-center justify-between gap-3 text-sm">
+              <Checkbox name="remember" value="1">
+                <Checkbox.Content>
+                  <Checkbox.Control>
+                    <Checkbox.Indicator />
+                  </Checkbox.Control>
+                  Remember me
+                </Checkbox.Content>
+              </Checkbox>
+              {canResetPassword && <Link href={forgotPassword.url()}>Forgot your password?</Link>}
+            </div>
+            <Button isPending={processing} type="submit">
+              Sign in
+            </Button>
+          </>
+        )}
+      </Form>
+    </>
+  )
+}
