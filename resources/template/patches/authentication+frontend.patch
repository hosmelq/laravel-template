diff --git a/tests/Feature/Http/AuthenticationPagesTest.php b/tests/Feature/Http/AuthenticationPagesTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Feature/Http/AuthenticationPagesTest.php
@@ -0,0 +1,45 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\get;
+
+use App\Models\User;
+use Illuminate\Support\Facades\Route;
+use Inertia\Testing\AssertableInertia;
+
+it('renders the login page for guests', function (): void {
+    $response = get('/login');
+
+    $response->assertOk()
+        ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page->component('auth/Login'));
+});
+
+it('redirects guests to the login page', function (): void {
+    Route::middleware(['web', 'auth'])
+        ->get('/_test/protected', fn (): string => 'ok');
+
+    $response = get('/_test/protected');
+
+    $response->assertRedirect('/login');
+});
+
+it('renders the email verification notice for unverified users', function (): void {
+    login(User::factory()->unverified()->createOne());
+
+    $response = get('/email/verify');
+
+    $response->assertOk()
+        ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page->component('auth/VerifyEmail'));
+});
+
+it('sends unverified users to the email verification notice', function (): void {
+    Route::middleware(['web', 'auth', 'verified'])
+        ->get('/_test/verified', fn (): string => 'ok');
+
+    login(User::factory()->unverified()->createOne());
+
+    $response = get('/_test/verified');
+
+    $response->assertRedirect('/email/verify');
+});
