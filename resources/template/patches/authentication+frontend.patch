@@ -0,0 +1,205 @@
+<?php
+
+declare(strict_types=1);
+
+use function Pest\Laravel\get;
+
+use App\Enums\EmailVerificationWarning;
+use App\Models\User;
+use Illuminate\Routing\Exceptions\InvalidSignatureException;
+use Illuminate\Support\Facades\Route;
+use Illuminate\Support\Facades\URL;
+use Inertia\Testing\AssertableInertia;
+use Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException;
+
+it('renders the login page for guests', function (): void {
+    $response = get('/login');
+
+    $response->assertOk()
+        ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page->component('auth/Login'));
+});
+
+it('redirects guests to the login page', function (): void {
+    Route::middleware(['web', 'auth'])
+        ->get('/_test/protected', fn (): string => 'ok');
+
+    $response = get('/_test/protected');
+
+    $response->assertRedirect('/login');
+});
+
+it('renders the email verification notice for unverified users', function (): void {
+    login(User::factory()->unverified()->createOne());
+
+    $response = get('/email/verify');
+
+    $response->assertOk()
+        ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page->component('auth/VerifyEmail'));
+});
+
+it('sends unverified users to the email verification notice', function (): void {
+    Route::middleware(['web', 'auth', 'verified'])
+        ->get('/_test/verified', fn (): string => 'ok');
+
+    login(User::factory()->unverified()->createOne());
+
+    $response = get('/_test/verified');
+
+    $response->assertRedirect('/email/verify');
+});
+
+it('passes login status and enabled features', function (): void {
+    $response = get('/login');
+
+    $response->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+        ->component('auth/Login')
+        ->where('canRegister', true)
+        ->where('canResetPassword', true)
+        ->where('status', null));
+});
+
+it('passes disabled feature flags to login', function (): void {
+    config()->set('fortify.features', []);
+
+    get('/login')->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+        ->where('canRegister', false)
+        ->where('canResetPassword', false));
+});
+
+it('passes session status to the login and forgot password views', function (string $path): void {
+    $this->withSession(['status' => 'Your password has been reset.']);
+
+    get($path)->assertOk()->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+        ->where('status', 'Your password has been reset.'));
+})->with(['forgot password' => '/forgot-password', 'login' => '/login']);
+
+it('renders registration for guests', function (): void {
+    get('/register')->assertOk()->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+        ->component('auth/Register'));
+});
+
+it('renders the forgot password view', function (): void {
+    get('/forgot-password')->assertOk()->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+        ->component('auth/ForgotPassword')
+        ->where('status', null));
+});
+
+it('passes the reset token and email to the reset password view', function (): void {
+    get('/reset-password/example-token?email=alex%2Btest%40example.com')->assertOk()
+        ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+            ->component('auth/ResetPassword')
+            ->where('email', 'alex+test@example.com')
+            ->where('token', 'example-token'));
+});
+
+it('renders a reset password view without an email', function (): void {
+    get('/reset-password/example-token')->assertOk()
+        ->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page->where('email', ''));
+});
+
+it('passes the signed in email and empty verification status', function (): void {
+    login(User::factory()->unverified()->createOne(['email' => 'alex@example.com']));
+
+    get('/email/verify')->assertOk()->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+        ->component('auth/VerifyEmail')
+        ->where('email', 'alex@example.com')
+        ->where('status', null)
+        ->where('warning', null));
+});
+
+it('passes verification status and warnings', function (EmailVerificationWarning $warning): void {
+    login(User::factory()->unverified()->createOne());
+    $this->withSession([
+        'status' => 'verification-link-sent',
+        'verification_warning' => $warning,
+    ]);
+
+    get('/email/verify')->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+        ->where('status', 'verification-link-sent')
+        ->where('warning', $warning->value));
+})->with(EmailVerificationWarning::cases());
+
+it('requires authentication for verification pages', function (string $path): void {
+    get($path)->assertRedirectToRoute('login');
+})->with(['confirmed' => '/email/verified', 'notice' => '/email/verify']);
+
+it('requires verified email before showing the confirmation page', function (): void {
+    login(User::factory()->unverified()->createOne());
+
+    get('/email/verified')->assertRedirectToRoute('verification.notice');
+});
+
+it('renders email confirmation with the signed in first name', function (): void {
+    login(User::factory()->createOne(['first_name' => 'Alex']));
+
+    get('/email/verified')->assertOk()->assertInertia(fn (AssertableInertia $page): AssertableInertia => $page
+        ->component('auth/EmailConfirmed')
+        ->where('firstName', 'Alex'));
+});
+
+it('redirects a verified email to the confirmation page', function (): void {
+    $user = login(User::factory()->unverified()->createOne());
+    $url = URL::temporarySignedRoute('verification.verify', now()->addHour(), [
+        'hash' => sha1($user->email),
+        'id' => $user->id,
+    ]);
+
+    get($url)->assertRedirect('/email/verified?verified=1');
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+it('redirects expired and invalid verification signatures to a warning', function (bool $expired): void {
+    $user = login(User::factory()->unverified()->createOne());
+    $url = URL::temporarySignedRoute('verification.verify', $expired ? now()->subMinute() : now()->addHour(), [
+        'hash' => sha1($user->email),
+        'id' => $user->id,
+    ]);
+
+    get($expired ? $url : $url.'tampered')->assertRedirectToRoute('verification.notice')
+        ->assertSessionHas('verification_warning', EmailVerificationWarning::Expired->value);
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse();
+})->with(['expired' => true, 'invalid' => false]);
+
+it('redirects another account verification link to a warning', function (string $mismatch): void {
+    $user = login(User::factory()->unverified()->createOne());
+    $url = URL::temporarySignedRoute('verification.verify', now()->addHour(), [
+        'hash' => $mismatch === 'hash' ? sha1('other@example.com') : sha1($user->email),
+        'id' => $mismatch === 'id' ? $user->id + 1 : $user->id,
+    ]);
+
+    get($url)->assertRedirectToRoute('verification.notice')
+        ->assertSessionHas('verification_warning', EmailVerificationWarning::OtherAccount->value);
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse();
+})->with(['hash', 'id']);
+
+it('redirects verified users home when a link belongs to another account', function (): void {
+    $user = login();
+    $url = URL::temporarySignedRoute('verification.verify', now()->addHour(), [
+        'hash' => sha1('other@example.com'),
+        'id' => $user->id,
+    ]);
+
+    get($url)->assertRedirect('/')->assertSessionMissing('verification_warning');
+});
+
+it('keeps unrelated signature and authorization errors forbidden', function (string $exception): void {
+    Route::middleware('web')->get('/_test/forbidden', function () use ($exception): never {
+        throw new $exception();
+    });
+
+    get('/_test/forbidden')->assertForbidden()->assertSessionMissing('verification_warning');
+})->with([
+    'authorization' => AccessDeniedHttpException::class,
+    'signature' => InvalidSignatureException::class,
+]);
+
+it('redirects to login after signing out', function (): void {
+    login();
+
+    $this->post('/logout')->assertRedirect('/login');
+
+    $this->assertGuest();
+});
