#!/usr/bin/env bash

set -Eeuo pipefail

readonly repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly temporary_root="$(mktemp -d "${TMPDIR:-/tmp}/laravel-template-features.XXXXXX")"
readonly checkout="$temporary_root/checkout"
readonly snapshot="$temporary_root/checkout.tar"

cleanup() {
    local exit_code=$?

    if [[ $exit_code -eq 0 ]]; then
        if command -v trash >/dev/null 2>&1; then
            trash "$temporary_root"
        else
            trash-put "$temporary_root"
        fi
    else
        printf '\nTemporary checkout preserved at %s\n' "$temporary_root" >&2
    fi
}

contains() {
    local expected="$1"
    shift

    local value

    for value in "$@"; do
        if [[ "$value" == "$expected" ]]; then
            return 0
        fi
    done

    return 1
}

validate_dependency_analyser_ignores() {
    local configuration="$1"
    shift

    php -r '
        $contents = file_get_contents($argv[1]);

        if (! preg_match("/->ignoreErrorsOnPackages\\(\\[\\R(?<packages>.*?)\\R    \\], \\[ErrorType::UNUSED_DEPENDENCY\\]\\);/s", $contents, $matches)) {
            throw new RuntimeException("Unable to read unused dependency ignores.");
        }

        preg_match_all("/'"'"'([^'"'"']+)'"'"'/", $matches["packages"], $packageMatches);

        $expected = [
            "laravel/tinker",
            "propaganistas/laravel-phone",
            "thecodingmachine/safe",
            "tpetry/laravel-query-expressions",
        ];
        $selected = array_slice($argv, 2);

        if (in_array("authentication", $selected, true)) {
            $expected[] = "propaganistas/laravel-disposable-email";
        }

        if (in_array("frontend", $selected, true)) {
            $expected[] = "inertiaui/modal";
            $expected[] = "laravel/wayfinder";
        }

        if (in_array("media", $selected, true)) {
            $expected[] = "league/flysystem-aws-s3-v3";
        }

        if (in_array("organizations", $selected, true)) {
            $expected = array_values(array_diff($expected, ["thecodingmachine/safe"]));
        }

        $actual = $packageMatches[1];

        sort($actual);
        sort($expected);

        if ($actual !== $expected) {
            throw new RuntimeException(sprintf(
                "Unexpected unused dependency ignores. Expected %s; found %s.",
                json_encode($expected, JSON_THROW_ON_ERROR),
                json_encode($actual, JSON_THROW_ON_ERROR),
            ));
        }
    ' "$configuration" "$@"
}

trap cleanup EXIT

git clone --no-hardlinks --quiet "$repository_root" "$checkout"

git -C "$repository_root" diff --binary HEAD -- . > "$temporary_root/working-tree.patch"

if [[ -s "$temporary_root/working-tree.patch" ]]; then
    git -C "$checkout" apply --whitespace=nowarn "$temporary_root/working-tree.patch"
fi

while IFS= read -r -d '' path; do
    mkdir -p "$checkout/$(dirname "$path")"
    cp -pP "$repository_root/$path" "$checkout/$path"
done < <(git -C "$repository_root" ls-files --others --exclude-standard -z)

tar -C "$checkout" --exclude='.git' -cf "$snapshot" .

features=()
patch_order=(health media frontend authentication organizations)

while IFS= read -r feature; do
    features+=("$feature")
done < <(php -r 'require $argv[1]; foreach (App\Enums\TemplateFeature::cases() as $feature) { echo $feature->value, PHP_EOL; }' "$repository_root/vendor/autoload.php")

for feature in "${features[@]}"; do
    if ! contains "$feature" "${patch_order[@]}"; then
        printf 'Missing patch order for %s.\n' "$feature" >&2

        exit 1
    fi

    if [[ ! -f "$checkout/resources/template/patches/$feature.patch" ]]; then
        printf 'Missing patch for %s.\n' "$feature" >&2

        exit 1
    fi
done

readonly total=$(((1 << ${#features[@]}) - 1))

validate_dependency_analyser_ignores "$checkout/composer-dependency-analyser.php"

for ((mask = 1; mask <= total; mask++)); do
    selected=()

    for ((index = 0; index < ${#features[@]}; index++)); do
        if (((mask & (1 << index)) != 0)); then
            selected+=("${features[$index]}")
        fi
    done

    scenario="$temporary_root/$mask"
    mkdir "$scenario"
    tar -C "$scenario" -xf "$snapshot"

    patches=()

    for feature in "${patch_order[@]}"; do
        if contains "$feature" "${selected[@]}"; then
            patches+=("$scenario/resources/template/patches/$feature.patch")
        fi
    done

    printf '[%02d/%02d] %s\n' "$mask" "$total" "${selected[*]}"

    git -C "$scenario" apply --check --unidiff-zero "${patches[@]}"
    git -C "$scenario" apply --unidiff-zero "${patches[@]}"

    php -r 'json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);' "$scenario/composer.json"

    validate_dependency_analyser_ignores "$scenario/composer-dependency-analyser.php" "${selected[@]}"

    if [[ -f "$scenario/package.json" ]]; then
        php -r 'json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);' "$scenario/package.json"
    fi

    if contains frontend "${selected[@]}"; then
        php -r '
            $composer = json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);
            $package = json_decode(file_get_contents($argv[2]), true, 512, JSON_THROW_ON_ERROR);
            $renovate = json_decode(file_get_contents($argv[3]), true, 512, JSON_THROW_ON_ERROR);

            if (($composer["require-dev"]["pestphp/pest-plugin-browser"] ?? null) !== "^5.0") {
                throw new RuntimeException("The generated Composer dependencies must install Pest Browser Testing.");
            }

            if (($package["packageManager"] ?? null) !== "nub@0.7.5") {
                throw new RuntimeException("The generated packageManager must pin Nub 0.7.5.");
            }

            if (($package["devEngines"]["packageManager"] ?? null) !== [
                "name" => "nub",
                "version" => "^0.7.5",
                "onFail" => "warn",
            ]) {
                throw new RuntimeException("The generated devEngines requirement must target Nub 0.7.5.");
            }

            if (($package["devDependencies"]["playwright"] ?? null) !== "^1.62.1") {
                throw new RuntimeException("The generated frontend dependencies must install Playwright.");
            }

            if (! in_array("nub.lock", $renovate["includePaths"] ?? [], true)) {
                throw new RuntimeException("Renovate must include the Nub lockfile.");
            }
        ' "$scenario/composer.json" "$scenario/package.json" "$scenario/.github/renovate.json"

        [[ -f "$scenario/nub.jsonc" ]]
        [[ -f "$scenario/tests/Browser/.gitkeep" ]]
        [[ ! -e "$scenario/pnpm-workspace.yaml" ]]
        grep -Fq '/tests/Browser/Screenshots' "$scenario/.gitignore"
        grep -Fq '<testsuite name="Browser">' "$scenario/phpunit.xml"
        grep -Fq '<directory>tests/Browser</directory>' "$scenario/phpunit.xml"
        grep -Fq -- "->in('Browser', 'Feature', 'Integration', 'Unit');" "$scenario/tests/Pest.php"
        grep -Fq 'nub exec playwright install --with-deps' "$scenario/.github/workflows/ci.yml"
    fi
done

printf '\nAll %d feature combinations passed.\n' "$total"
