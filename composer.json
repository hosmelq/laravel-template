{
  "name": "laravel/laravel",
  "description": "The skeleton application for the Laravel framework.",
  "license": "MIT",
  "type": "project",
  "keywords": [
    "laravel",
    "framework"
  ],
  "authors": [
    {
      "name": "Hosmel Quintana",
      "email": "hosmelq@gmail.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-bcmath": "*",
    "archtechx/enums": "^1.1.2",
    "ashallendesign/laravel-config-validator": "^2.10",
    "filament/filament": "^5.11.0",
    "hosmelq/laravel-audit-logs": "^2.0",
    "hosmelq/name-of-person": "^0.3.0",
    "laravel/framework": "^13.36.0",
    "laravel/octane": "^2.22.0",
    "laravel/tinker": "^3.0.2",
    "propaganistas/laravel-phone": "^6.0.3",
    "resend/resend-php": "^1.17.0",
    "sentry/sentry-laravel": "^4.29.0",
    "sqids/sqids": "^0.5",
    "thecodingmachine/safe": "^3.4",
    "tpetry/laravel-postgresql-enhanced": "^3.7",
    "tpetry/laravel-query-expressions": "^1.6"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.54.0",
    "fakerphp/faker": "^1.24.1",
    "fruitcake/laravel-debugbar": "^4.4.4",
    "hosmelq/php-coding-standard": "^1.1.0",
    "larastan/larastan": "^3.13.0",
    "laravel/boost": "^2.10.3",
    "laravel/pail": "^1.2.7",
    "laravel/pao": "^1.1.5",
    "mockery/mockery": "^1.6.15",
    "nunomaduro/collision": "^8.9.5",
    "pestphp/pest": "^5.3.2",
    "pestphp/pest-plugin-agent": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0.1",
    "pestphp/pest-plugin-rector": "^5.0.6",
    "shipmonk/composer-dependency-analyser": "^1.8.4"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "scripts": {
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "@composer bump",
      "@composer normalize",
      "@php artisan boost:install --ansi --guidelines --skills --no-interaction"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade"
    ],
    "ecs": "ecs check --fix",
    "ecs:check": "ecs check",
    "phpstan": "phpstan analyse --memory-limit=4G",
    "rector": "rector"
  },
  "scripts-descriptions": {
    "ecs": "Runs ECS and fixes code style.",
    "ecs:check": "Checks code style with ECS.",
    "phpstan": "Runs PHPStan analyse.",
    "rector": "Runs Rector."
  },
  "$schema": "https://getcomposer.org/schema.json"
}
