{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "jsonata",
      "datasourceTemplate": "npm",
      "fileFormat": "json",
      "managerFilePatterns": ["/^(?:\\.railway/)?package\\.json$/"],
      "matchStrings": [
        "devEngines.packageManager[name = 'nub'].{'currentValue': version, 'depName': 'nub', 'depType': 'packageManager', 'packageName': '@nubjs/nub'}"
      ],
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/mise",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "managerFilePatterns": ["mise.toml"],
      "matchStrings": ["min_version = \"(?<currentValue>[^\"]+)\""]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node",
      "managerFilePatterns": [".github/workflows/*.yml"],
      "matchStrings": ["NODE_VERSION: '(?<currentValue>[^']+)'"]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "npm",
      "depNameTemplate": "nub",
      "managerFilePatterns": [".github/workflows/*.yml"],
      "matchStrings": ["NUB_VERSION: '(?<currentValue>[^']+)'"],
      "packageNameTemplate": "@nubjs/nub"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "zizmorcore/zizmor",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "managerFilePatterns": [".github/workflows/zizmor.yml"],
      "matchStrings": ["version: (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"]
    }
  ],
  "dependencyDashboard": true,
  "enabledManagers": [
    "composer",
    "custom.jsonata",
    "custom.regex",
    "docker-compose",
    "github-actions",
    "mise",
    "npm"
  ],
  "extends": [
    "config:recommended",
    "group:all",
    "helpers:pinGitHubActionDigests",
    "schedule:weekly"
  ],
  "includePaths": [
    ".github/workflows/**",
    "compose.yml",
    "composer.json",
    "mise.toml"
  ],
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "matchDepNames": ["pullfrog/pullfrog"],
      "matchManagers": ["github-actions"],
      "pinDigests": false
    },
    {
      "enabled": false,
      "matchDepNames": ["ghcr.io/nubjs/nub", "ghcr.io/zizmorcore/zizmor", "php"]
    },
    {
      "matchManagers": ["composer"],
      "postUpdateOptions": ["composerWithAll"],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": ["custom.jsonata", "npm"],
      "rangeStrategy": "bump"
    }
  ],
  "rebaseWhen": "conflicted",
  "semanticCommits": "enabled",
  "timezone": "America/Managua",
  "updateNotScheduled": false
}
